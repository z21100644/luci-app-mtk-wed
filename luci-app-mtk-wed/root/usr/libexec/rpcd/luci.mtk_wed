#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# rpcd backend for luci-app-mtk-wed: hardware offload status for MediaTek
# Filogic SoCs (MT7981, MT7986, MT7987, MT7988) on the mainline kernel.
#
# Data sources (kernel 6.18, mt76 467ae2e):
#   /sys/kernel/debug/ppeN/{entries,bind}  mtk_ppe_debugfs.c, one dir per PPE
#                                          (two on MT7981/6/7, three on MT7988)
#   /sys/kernel/debug/wedN/{txinfo,...}    mtk_wed_debugfs.c; txinfo is empty
#                                          while no WLAN device is attached
#   /sys/module/<mod>/parameters/wed_enable   mt76 module parameter of
#                                          mt7915e or mt7996e
#   /etc/modules.conf                      "options <mod> wed_enable=Y" makes
#                                          the parameter survive a reboot
#
# MTKW_ROOT prefixes every filesystem path; it is empty on a router and only
# set by the test harness.

R="${MTKW_ROOT:-}"
DBG="$R/sys/kernel/debug"
MODCONF="$R/etc/modules.conf"
# Samples and caches live in a directory only root can create: unprivileged
# daemons can write to /tmp but not to /var/run, so none of these names can
# be planted there as a FIFO, a symlink or forged data.
STATE="$R/var/run/mtk-wed"
# One file per Wi-Fi sample, named by its uptime in centiseconds; readers
# take the newest, so a slow writer can never roll the sample back.
WIFI_SNAP="$STATE/wifi"
WIFI_MIN_DT=2
# Seconds the iw reads of one sample may take: its counters carry the time
# taken before them, so a slower sample cannot be placed in time.
WIFI_MAX_SPAN=1
NL='
'
PPE_MAX_ENTRIES=1000

# jesc(s): s escaped for a JSON string. It is built by concatenation only:
# BusyBox awk versions differ in how gsub() reads backslashes in a
# replacement, and 1.37/1.38 neither double them nor escape quotes.
JESC_AWK='
function jesc(s,   i, n, c, out) {
	if (!JE_INIT) {
		JE_INIT = 1
		for (i = 1; i < 32; i++) JE[sprintf("%c", i)] = sprintf("\\u%04x", i)
		JE["\t"] = "\\t"; JE["\n"] = "\\n"; JE["\r"] = "\\r"
		JE["\\"] = "\\\\"; JE["\""] = "\\\""
	}
	out = ""; n = length(s)
	for (i = 1; i <= n; i++) { c = substr(s, i, 1); out = out ((c in JE) ? JE[c] : c) }
	return out
}
'

json_str() {
	# Escape a value for use inside a JSON string; lines join as \n.
	printf '%s' "$1" | awk "$JESC_AWK"'{ printf "%s%s", (NR > 1 ? "\\n" : ""), jesc($0) }'
}

# The page polls every five seconds, so the hot paths avoid subshells and
# helper processes: rd, ri and js return in variables and use builtins only.

# rd <file>: first line of a file in $RD, empty when it cannot be read.
rd() {
	RD=
	[ -r "$1" ] && IFS= read -r RD 2>/dev/null < "$1"
	return 0
}

# ri <file> <fallback>: the file's integer value in $RI, else the fallback.
ri() {
	rd "$1"
	case "$RD" in ''|*[!0-9-]*) RI=$2 ;; *) RI=$RD ;; esac
}

# js <value>: the value escaped for a JSON string in $JS; plain values skip
# the awk process.
js() {
	case "$1" in
		*[\"\\]*|*[![:print:]]*) JS=$(json_str "$1") ;;
		*) JS=$1 ;;
	esac
}

read_first() {
	rd "$1"
	printf '%s' "$RD"
}

int_or() {
	# int_or <value> <fallback>
	case "$1" in ''|*[!0-9-]*) printf '%s' "$2" ;; *) printf '%s' "$1" ;; esac
}

# Module arguments split and decoded like the kernel's next_arg(): spaces
# inside double quotes do not split, quotes around a value are dropped, a
# name matches with "-" or "_" and an argument without "=" means "1".
# kargs(s, out) fills out[1..n] with the raw arguments; karg(a) sets KN and KV.
KARGS_AWK='
function kargs(s, out,   n, i, len, c, q, st) {
	n = 0; len = length(s); i = 1
	while (i <= len) {
		while (i <= len && substr(s, i, 1) ~ /[[:space:]]/) i++
		if (i > len) break
		st = i; q = 0
		if (substr(s, i, 1) == "\"") { q = 1; i++ }
		for (; i <= len; i++) {
			c = substr(s, i, 1)
			if (c ~ /[[:space:]]/ && !q) break
			if (c == "\"") q = !q
		}
		out[++n] = substr(s, st, i - st)
	}
	return n
}
function unq(v) {
	if (substr(v, 1, 1) == "\"") { v = substr(v, 2); if (substr(v, length(v)) == "\"") v = substr(v, 1, length(v) - 1) }
	return v
}
function karg(a,   e) {
	a = unq(a); e = index(a, "=")
	if (e) { KN = substr(a, 1, e - 1); KV = unq(substr(a, e + 1)) } else { KN = a; KV = "1" }
	gsub(/-/, "_", KN)
}
'

# kbool <value>: kstrtobool() as the kernel applies it to a bool module
# parameter, into $KB as true, false or null.
kbool() {
	case "$1" in
		[eEyYtT1]*|[oO][nN]*) KB=true ;;
		[dDnNfF0]*|[oO][fF]*) KB=false ;;
		*) KB=null ;;
	esac
}

json_input() {
	# json_input <json> <key>
	printf '%s' "$1" | jsonfilter -e "@.$2" 2>/dev/null
}

# ── Board / CPU ─────────────────────────────────────────────────────────

board_compatible() {
	tr '\0' ' ' < "$R/proc/device-tree/compatible" 2>/dev/null | awk '{print $1}'
}

# The last compatible string names the SoC, e.g. "mediatek,mt7988a".
soc_compatible() {
	tr '\0' ' ' < "$R/proc/device-tree/compatible" 2>/dev/null | awk '{print $NF}'
}

cpu_policy() {
	local p
	for p in "$R"/sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$p" ] && { printf '%s' "$p"; return; }
	done
}

# CPU temperature in millidegrees into $RI (0 when unknown).
cpu_temp_milli() {
	local z
	for z in "$R"/sys/class/thermal/thermal_zone*; do
		rd "$z/type"
		case "$RD" in cpu-thermal|cpu_thermal|soc-thermal|soc_thermal)
			ri "$z/temp" 0; return ;;
		esac
	done
	ri "$R/sys/class/thermal/thermal_zone0/temp" 0
}

cpu_json() {
	local p gov govs freqs cur min max hwmax count arch temp
	p=$(cpu_policy)
	count=$(grep -c '^processor' "$R/proc/cpuinfo" 2>/dev/null)
	arch=$(awk -F': *' '/^CPU part/{print $2; exit}' "$R/proc/cpuinfo" 2>/dev/null)
	case "$arch" in
		0xd09) arch='Cortex-A73' ;; 0xd08) arch='Cortex-A72' ;;
		0xd03) arch='Cortex-A53' ;; 0xd05) arch='Cortex-A55' ;;
	esac
	cpu_temp_milli; temp=$RI
	if [ -n "$p" ]; then
		rd "$p/scaling_governor"; gov=$RD
		rd "$p/scaling_available_governors"; govs=$RD
		rd "$p/scaling_available_frequencies"; freqs=$RD
		ri "$p/scaling_cur_freq" 0; cur=$RI
		ri "$p/cpuinfo_min_freq" 0; min=$RI
		ri "$p/cpuinfo_max_freq" 0; hwmax=$RI
		ri "$p/scaling_max_freq" 0; max=$RI
	fi
	case "$count" in ''|*[!0-9]*) count=0 ;; esac
	js "$arch"; arch=$JS
	js "$gov"; gov=$JS
	js "$govs"; govs=$JS
	js "$freqs"; freqs=$JS
	printf '"cpu":{"count":%s,"arch":"%s","temp_milli":%s,"cpufreq":%s,"governor":"%s","governors":"%s","frequencies":"%s","cur_freq":%s,"min_freq":%s,"hw_max_freq":%s,"max_freq":%s}' \
		"$count" "$arch" "$temp" "$([ -n "$p" ] && echo true || echo false)" \
		"$gov" "$govs" "$freqs" "${cur:-0}" "${min:-0}" "${hwmax:-0}" "${max:-0}"
}

# Monotonic seconds: no date process and no wall-clock/NTP jumps.
clock_now() {
	local rest
	NOW=
	[ -r "$R/proc/uptime" ] && read -r NOW rest < "$R/proc/uptime"
	NOW=${NOW%%.*}
	case "$NOW" in ''|*[!0-9]*) NOW=; return 1 ;; esac
}

# ppe_fresh <sources> <ttl>: the snapshot covers these tables and is younger
# than ttl seconds at $NOW.
ppe_fresh() {
	local stamp generation saved
	[ -f "$PPE_SNAPSHOT" ] || return 1
	{ read -r stamp generation; IFS= read -r saved; } < "$PPE_SNAPSHOT"
	case "$stamp" in ''|*[!0-9]*) return 1 ;; esac
	[ "$saved" = "$1" ] && [ "$NOW" -ge "$stamp" ] && [ $((NOW - stamp)) -lt "$2" ]
}

# Cache raw PPE data, not a truncated result. One atomically replaced file
# keeps every engine in the same generation; readers pin its inode on fd 3.
# One caller collects at a time; the others wait and take its snapshot, so
# concurrent requests cannot multiply the copies held in RAM.
ppe_snapshot() {
	local sources="$1" ttl="$2"
	PPE_SNAPSHOT="$STATE/ppe.snapshot"
	clock_now || return 1
	ppe_fresh "$sources" "$ttl" && return 0
	# Read the clock again once the lock is held: a caller that waited
	# judges, and stamps, by the time it actually samples.
	{ flock 4 && clock_now && { ppe_fresh "$sources" "$ttl" || ppe_collect "$sources"; }; } 4> "$STATE/ppe.lock"
}

ppe_collect() {
	local tmp f id
	tmp=$(mktemp "$PPE_SNAPSHOT.XXXXXX") || return 1
	printf '%s %s\n%s\n' "$NOW" "${tmp##*/}" "$1" > "$tmp" || { rm -f "$tmp"; return 1; }
	for f in $1; do
		id=${f%/entries}; id=${id##*/ppe}
		printf '#PPE %s\n' "$id" >> "$tmp" || { rm -f "$tmp"; return 1; }
		if ! cat "$f" >> "$tmp"; then rm -f "$tmp"; return 1; fi
	done
	mv -f "$tmp" "$PPE_SNAPSHOT" || { rm -f "$tmp"; return 1; }
}

ppe_reply() {
	if [ "$2" = 1 ]; then
		printf '%s,"sample_age":%s}' "${1%\}}" "$3"
	else
		printf '%s' "$1"
	fi
}

# ── PPE ─────────────────────────────────────────────────────────────────

# One JSON object per PPE: entry counts by state and by type. The FOE table
# only prints valid entries, so counting lines is enough.
ppe_json() {
	local d id first=1 out=""
	for d in "$DBG"/ppe[0-9]*; do
		[ -r "$d/entries" ] || continue
		id=${d##*/ppe}
		[ $first -eq 1 ] || out="$out,"
		first=0
		out="$out$(awk -v id="$id" '
			{ total++; s[$2]++; t=$3; if ($4 != "" && $4 !~ /=/) t=t" "$4; ty[t]++ }
			END {
				printf "{\"id\":%d,\"total\":%d,\"bound\":%d,\"unbound\":%d,\"fin\":%d,\"ipv4\":%d,\"ipv6\":%d}",
					id, total, s["BND"], s["UNB"], s["FIN"],
					ty["IPv4 5T"]+ty["IPv4 3T"]+ty["DS-LITE"],
					ty["IPv6 5T"]+ty["IPv6 3T"]+ty["6RD"]
			}' "$d/entries" 2>/dev/null)"
	done
	printf '"ppe":[%s]' "$out"
}

# Count every FOE entry once; serialize only the requested page. Calls without
# a page retain the original PPE_MAX_ENTRIES cap for existing clients.
# Line format (mtk_ppe_debugfs.c):
#   %05x <state> <type 1-2 words> orig=<a>-><b> [new=<a>-><b>] eth=<m>-><m>
#   etype=%04x vlan=%d,%d ib1=%08x ib2=%08x packets=%llu bytes=%llu
get_ppe_entries() {
	local d id page= state= type_filter= ppe_filter= result args files=""
	local snapshot=0 ttl=20 refresh= interval= stamp generation saved key cached_key cached_json tmp age=0
	local page_kind= state_kind= type_kind= ppe_kind= refresh_kind= interval_kind=
	local query_cache="$STATE/ppe.query" meta_prefix= meta_suffix=
	# jsonfilter quotes exported strings for shell evaluation. Names and
	# expressions are fixed here; user input is only parsed as JSON data.
	args=$(jsonfilter -s "$1" -e 'page=@.page' -e 'state=@.state' \
		-e 'type_filter=@.type' -e 'ppe_filter=@.ppe' -e 'refresh=@.refresh' -e 'interval=@.interval' \
		-t 'page_kind=@.page' -t 'state_kind=@.state' -t 'type_kind=@.type' \
		-t 'ppe_kind=@.ppe' -t 'refresh_kind=@.refresh' -t 'interval_kind=@.interval' 2>/dev/null)
	eval "$args"
	case "$page_kind" in ''|null|string|int) ;; *) printf '{"error":"invalid page"}'; return ;; esac
	case "$state_kind" in ''|null|string) ;; *) printf '{"error":"invalid state"}'; return ;; esac
	case "$type_kind" in ''|null|string) ;; *) printf '{"error":"invalid type"}'; return ;; esac
	case "$ppe_kind" in ''|null|string|int) ;; *) printf '{"error":"invalid ppe"}'; return ;; esac
	case "$interval_kind" in ''|null|int) ;; *) printf '{"error":"invalid interval"}'; return ;; esac
	case "$interval" in *[!0-9]*|?????*) printf '{"error":"invalid interval"}'; return ;; esac
	# No page keeps the original capped response for existing RPC clients.
	case "$page" in
		'') page=-1 ;;
		*[!0-9]*|???????*) printf '{"error":"invalid page"}'; return ;;
	esac
	case "$state" in ''|BND|UNB|FIN) ;; *) printf '{"error":"invalid state"}'; return ;; esac
	case "$type_filter" in ''|IPv4|IPv6|DS-LITE|6RD) ;; *) printf '{"error":"invalid type"}'; return ;; esac
	case "$ppe_filter" in *[!0-9]*|???????*) printf '{"error":"invalid ppe"}'; return ;; esac
	for d in "$DBG"/ppe[0-9]*; do
		[ -r "$d/entries" ] && files="$files $d/entries"
	done
	if [ -z "$files" ]; then
		printf '{"available":false,"entries":[],"total":0,"matched":0,"ppe":[]}'
		return
	fi
	if [ "$page" -ge 0 ]; then
		# Live polls come from each open page every "interval" seconds (20
		# when not given; at least 5, as a full table takes a while to copy).
		# A snapshot two seconds younger is shared between pages, while one
		# page, even with a second of timer or request jitter, still reads
		# fresh tables; it is never older than the 20 s that clicks accept.
		case "$refresh_kind:$refresh" in
			boolean:1|string:true)
				[ "${interval:-0}" -gt 0 ] || interval=20
				[ "$interval" -ge 5 ] || interval=5
				[ "$interval" -le 20 ] || interval=20
				ttl=$((interval - 2))
				;;
		esac
		if ! ppe_snapshot "$files" "$ttl"; then
			printf '{"available":false,"entries":[],"ppe":[],"error":"cannot snapshot PPE tables"}'
			return
		fi
		command exec 3< "$PPE_SNAPSHOT" 2>/dev/null || {
			printf '{"available":false,"entries":[],"ppe":[],"error":"cannot read the PPE snapshot"}'
			return
		}
		read -r stamp generation <&3
		IFS= read -r saved <&3
		age=$((NOW - stamp)); [ "$age" -ge 0 ] || age=0
		key="$generation:$page:$state:$type_filter:$ppe_filter"
		if [ -r "$query_cache" ]; then
			{ IFS= read -r cached_key; IFS= read -r cached_json; } < "$query_cache"
			if [ "$cached_key" = "$key" ]; then
				case "$cached_json" in
					\{*\}) exec 3<&-; ppe_reply "$cached_json" 1 "$age"; return ;;
				esac
			fi
			case "$cached_key" in
				"$generation":*)
					# The summary is independent of filter/page. Its numeric-only
					# prefix and PPE suffix can be reused without parsing JSON.
					meta_prefix=${cached_json%%,\"truncated\":*}
					meta_suffix=${cached_json##*,\"ppe\":}
					[ "$meta_prefix" != "$cached_json" ] && [ "$meta_suffix" != "$cached_json" ] || { meta_prefix=; meta_suffix=; }
					;;
			esac

		fi
		files=/proc/self/fd/3
		snapshot=1
	fi
	# shellcheck disable=SC2086
	if result=$(awk -v max="$PPE_MAX_ENTRIES" -v page="$page" -v state="$state" \
		-v type_filter="$type_filter" -v ppe_filter="$ppe_filter" -v snapshot="$snapshot" \
		-v meta_prefix="$meta_prefix" -v meta_suffix="$meta_suffix" "$JESC_AWK"'
		BEGIN {
			have_meta = meta_prefix != "" && meta_suffix != ""
			unfiltered = have_meta && state == "" && type_filter == "" && ppe_filter == ""
			if (unfiltered) {
				matched = meta_prefix; sub(/^.*"total":/, "", matched); sub(/,.*/, "", matched); matched += 0
			}
			if (page >= 0) max = 50
			for (i = 1; !snapshot && i < ARGC; i++) {
				id = ARGV[i]; sub(/\/entries$/, "", id); sub(/.*\/ppe/, "", id)
				ids[++idcount] = id
			}
		}
		function esc(s) { return (index(s, "\\") || index(s, "\"")) ? jesc(s) : s }
		function field(k) { return values[k] }
		function decode_fields(   i, eq, key) {
			delete values
			for (i = 1; i <= NF; i++) {
				eq = index($i, "="); if (!eq) continue
				key = substr($i, 1, eq - 1)
				if (!(key in values)) values[key] = substr($i, eq + 1)
			}
		}
		function finish_engine() {
			if (!active || have_meta) return
			pt[ppe] = etotal; pb[ppe] = ebound; pu[ppe] = eunbound
			pf[ppe] = efin; pv4[ppe] = ev4; pv6[ppe] = ev6
		}
		function start_engine(id) {
			finish_engine()
			ppe = id; active = 1
			etotal = ebound = eunbound = efin = ev4 = ev6 = 0
		}
		snapshot && FNR <= 2 { next }
		snapshot && $1 == "#PPE" { start_engine($2); ids[++idcount] = ppe; next }
		!snapshot && FNR == 1 { engine = FILENAME; sub(/\/entries$/, "", engine); sub(/.*\/ppe/, "", engine); start_engine(engine) }
		{
			if (unfiltered) {
				if (n >= max) exit
				if (++seen <= page * max) next
			}
			if (!have_meta) {
				etotal++
				if ($2 == "BND") ebound++; else if ($2 == "UNB") eunbound++; else if ($2 == "FIN") efin++
				if ($3 ~ /^IPv4|^DS-LITE/) ev4++; else if ($3 ~ /^IPv6|^6RD/) ev6++
			}
			if (!unfiltered) {
				if ((state != "" && $2 != state) ||
				    (type_filter != "" && index($3, type_filter) != 1) ||
				    (ppe_filter != "" && ppe + 0 != ppe_filter + 0)) next
				matched++
				if (n >= max || (page >= 0 && matched <= page * max)) next
			}
			type = $3; if ($4 !~ /=/) type = type " " $4
			decode_fields()
			vlan = field("vlan"); split(vlan, vl, ",")
			v = (vl[1] + 0) ? vl[1] : "-"
			if ((vl[2] + 0)) v = v "," vl[2]
			pk = field("packets"); by = field("bytes")
			row = sprintf("{\"ppe\":%d,\"index\":\"%s\",\"state\":\"%s\",\"type\":\"%s\",\"orig\":\"%s\",\"new\":\"%s\",\"eth\":\"%s\",\"vlan\":\"%s\",\"packets\":%s,\"bytes\":%s}",
				ppe, esc($1), esc($2), esc(type), esc(field("orig")), esc(field("new")), esc(field("eth")),
				esc(v), (pk == "" ? "null" : pk + 0), (by == "" ? "null" : by + 0))
			out = out (n ? "," : "") row
			n++
		}
		END {
			finish_engine()
			if (have_meta) {
				printf "%s,\"truncated\":false,\"matched\":%d,\"page\":%d,\"entries\":[%s],\"ppe\":%s", meta_prefix, matched, page, out, meta_suffix
				exit
			}
			# Derive global counts once, instead of updating them for every row.
			for (i = 1; i <= idcount; i++) {
				id = ids[i]; total += pt[id]; bound += pb[id]; unbound += pu[id]
				v4 += pv4[id]; v6 += pv6[id]
			}
			printf "{\"available\":true,\"total\":%d,\"bound\":%d,\"unbound\":%d,\"ipv4\":%d,\"ipv6\":%d,\"truncated\":%s,\"matched\":%d,\"page\":%d,\"entries\":[%s],\"ppe\":[",
				total, bound, unbound, v4, v6, (page < 0 && matched > n ? "true" : "false"), matched, page, out
			for (i = 1; i <= idcount; i++) {
				id = ids[i]
				printf "%s{\"id\":%d,\"total\":%d,\"bound\":%d,\"unbound\":%d,\"fin\":%d,\"ipv4\":%d,\"ipv6\":%d}",
					(i > 1 ? "," : ""), id, pt[id], pb[id], pu[id], pf[id], pv4[id], pv6[id]
			}
			printf "]}"
		}' $files 2>/dev/null); then
		exec 3<&-
		if [ "$snapshot" = 1 ]; then
			tmp=$(mktemp "$query_cache.XXXXXX")
			if [ -n "$tmp" ]; then
				printf '%s\n%s\n' "$key" "$result" > "$tmp" &&
					mv -f "$tmp" "$query_cache" || rm -f "$tmp"
			fi
		fi
		ppe_reply "$result" "$snapshot" "$age"
	else
		exec 3<&-
		printf '{"available":false,"entries":[],"ppe":[],"error":"cannot read PPE tables"}'
	fi
}

# ── WED ─────────────────────────────────────────────────────────────────

WO_CACHE="$STATE/wo-firmware"

# The WO firmware is logged only when a WED attaches, right after that WED's
# "attaching wed device N" line: mtk_wed_attach() holds hw_lock across both,
# so the lines of two WEDs never interleave. What was seen is kept, since
# the kernel log ring buffer drops it on a long-running router.
# Prints "<version>|<build>" of the last one logged, then "<wed>|<version>|<build>"
# for each WED it was logged for.
wo_firmware() {
	local top= stamp= l recs= seen= out tmp
	clock_now
	if [ -r "$WO_CACHE" ]; then
		{
			IFS= read -r top; read -r stamp
			while IFS= read -r l; do recs="$recs$l$NL"; seen="$seen@$l$NL"; done
		} < "$WO_CACHE"
		case "$stamp" in
			''|*[!0-9]*) ;;
			*) if [ -n "$NOW" ] && [ "$NOW" -ge "$stamp" ] && [ $((NOW - stamp)) -lt 60 ]; then
				printf '%s\n%s' "$top" "$recs"; return
			fi ;;
		esac
	fi
	# The cached lines come first, marked "@", so dmesg overrides them.
	out=$({ printf '%s' "$seen"; dmesg 2>/dev/null; } |
		awk -v top="$top" '
			/^@[0-9]+\|/ { s = substr($0, 2); i = index(s, "|"); wo[substr(s, 1, i - 1)] = substr(s, i + 1); next }
			/attaching wed device [0-9]+ version / { s = $0; sub(/.*attaching wed device /, "", s); sub(/ .*/, "", s); n = s; next }
			/MTK WED WO Firmware Version: [^,]*, Build Time: / {
				s = $0; sub(/.*MTK WED WO Firmware Version: /, "", s)
				i = index(s, ", Build Time: ")
				last = substr(s, 1, i - 1) "|" substr(s, i + 14)
				if (n != "") wo[n] = last
			}
			END { print (last != "" ? last : top); for (k in wo) print k "|" wo[k] }')
	top=${out%%"$NL"*}
	recs=
	case "$out" in *"$NL"*) recs="${out#*"$NL"}$NL" ;; esac
	if [ -n "$NOW" ]; then
		tmp=$(mktemp "$WO_CACHE.XXXXXX")
		if [ -n "$tmp" ]; then
			printf '%s\n%s\n%s' "$top" "$NOW" "$recs" > "$tmp" && mv -f "$tmp" "$WO_CACHE" || rm -f "$tmp"
		fi
	fi
	printf '%s\n%s' "$top" "$recs"
}

wed_module() {
	# The mt76 driver bound to a radio decides. kmodloader loads every
	# installed module, so a loaded module alone proves nothing.
	local p m
	for p in "$R"/sys/class/ieee80211/*/device/driver/module; do
		m=$(readlink "$p" 2>/dev/null); m=${m##*/}
		case "$m" in mt7915e|mt7996e) printf '%s' "$m"; return ;; esac
	done
	# No radio yet: MT7981/MT7986 carry a built-in WMAC driven by mt7915e,
	# MT7987/MT7988 boards use mt7996e PCIe cards.
	case "$(soc_compatible)" in
		*mt7981*|*mt7986*) printf 'mt7915e' ;;
		*) printf 'mt7996e' ;;
	esac
}

# Decode the two formats kmodloader reads. modules.conf strips comments and
# accepts whitespace before "options". Autoload files split at their first
# literal space, keep '#' in the arguments, and accept module paths/.ko names.
# Sharing this with the writer keeps the displayed setting and saved one alike.
WED_LINES_AWK='
function wed_conf(line,   i) {
	WA_CMD = WA_NAME = WA_ARGS = WA_SUFFIX = ""
	WA_HAS_ARGS = 0
	i = index(line, "#")
	if (i) { WA_SUFFIX = substr(line, i); line = substr(line, 1, i - 1) }
	sub(/^[[:space:]]*/, "", line); sub(/[[:space:]]*$/, "", line)
	i = match(line, /[ \t]/)
	if (!i) return 0
	WA_CMD = substr(line, 1, i - 1); line = substr(line, i + 1)
	sub(/^[[:space:]]*/, "", line)
	i = match(line, /[ \t]/)
	WA_NAME = i ? substr(line, 1, i - 1) : line
	WA_ARGS = i ? substr(line, i + 1) : ""
	sub(/^[[:space:]]*/, "", WA_ARGS)
	WA_HAS_ARGS = WA_ARGS != ""
	return WA_NAME != ""
}
function wed_line(line, conf,   i, name) {
	WA_PREFIX = WA_ARGS = WA_SUFFIX = ""
	if (conf) {
		if (!wed_conf(line) || WA_CMD != "options" || WA_NAME != mod) return 0
		WA_PREFIX = "options " mod
	} else {
		i = index(line, " ")
		WA_PREFIX = i ? substr(line, 1, i - 1) : line
		name = WA_PREFIX; sub(/.*\//, "", name); sub(/\.ko.*/, "", name)
		if (name != mod) return 0
		WA_ARGS = i ? substr(line, i + 1) : ""
		WA_HAS_ARGS = i > 0
	}
	return 1
}
'

# Effective explicit WED value at the normal boot stages, or null when unset
# or invalid. Early modules load first. In each directory numeric (and lower
# ASCII) file names load immediately; other names collect options until the
# final pass. Once this module loads, later entries cannot change its options.
wed_configured() {
	local mod="$1" f value
	set -- mode=conf /dev/null
	[ ! -f "$MODCONF" ] || set -- "$@" "$MODCONF"
	set -- "$@" mode=boot
	for f in "$R"/etc/modules-boot.d/*; do [ ! -f "$f" ] || set -- "$@" "$f"; done
	set -- "$@" mode=auto
	for f in "$R"/etc/modules.d/*; do [ ! -f "$f" ] || set -- "$@" "$f"; done
	value=$(awk -v mod="$mod" "$KARGS_AWK$WED_LINES_AWK"'
		mode == "conf" && wed_conf($0) && WA_CMD == "blacklist" && WA_NAME == mod { blocked = 1 }
		{
			if (done[mode] || !wed_line($0, mode == "conf")) next
			seen[mode] = 1
			if (WA_HAS_ARGS) {
				args[mode] = gotopts[mode] ? args[mode] " " WA_ARGS : WA_ARGS
				gotopts[mode] = 1
			}
			name = FILENAME; sub(/.*\//, "", name)
			if (mode != "conf" && substr(name, 1, 1) <= "9") done[mode] = 1
		}
		END {
			m = seen["boot"] ? "boot" : seen["auto"] ? "auto" : "conf"
			# kmodloader joins options before the kernel parses any quotes.
			combined = args["conf"]
			if (m != "conf" && gotopts[m]) combined = gotopts["conf"] ? combined " " args[m] : args[m]
			n = kargs(combined, t)
			for (j = 1; j <= n; j++) {
				karg(t[j]); if (KN != "wed_enable") continue
				v = KV; have = 1
				if (KV !~ /^([eEyYtT1dDnNfF0]|[oO][nNfF])/) bad = 1
			}
			if (blocked || bad) print "!"
			else if (have) print "v" v
		}' "$@" 2>/dev/null) || value=
	if [ -n "$value" ]; then kbool "${value#v}"; WC=$KB; else WC=null; fi
}

wed_param_json() {
	local mod live
	mod=$(wed_module)
	rd "$R/sys/module/$mod/parameters/wed_enable"; kbool "$RD"; live=$KB
	wed_configured "$mod"
	printf '"wed_param":{"module":"%s","active":%s,"configured":%s}' "$mod" "$live" "$WC"
}

# wed_json <SoC compatible>
wed_json() {
	local d id soc ver attached rx k v rest fw recs= wo out="" first=1
	fw=$(wo_firmware)
	case "$fw" in *"$NL"*) recs="$NL${fw#*"$NL"}$NL" ;; esac
	fw=${fw%%"$NL"*}
	# A WED has the version of its Ethernet SoC (mtk_wed_add_hw()); MT7987
	# is v3 in OpenWrt's mtk_eth_soc patch. Where the SoC is not one of
	# these, the debugfs files tell: rxinfo comes with v2 and rro with v3,
	# but a missing file proves nothing (null).
	case "$1" in
		*mt7622*) soc=1 ;;
		*mt7981*|*mt7986*) soc=2 ;;
		*mt7987*|*mt7988*) soc=3 ;;
		*) soc= ;;
	esac
	for d in "$DBG"/wed[0-9]*; do
		[ -d "$d" ] || continue
		id=${d##*/wed}
		if [ -n "$soc" ]; then ver=$soc
		elif [ -e "$d/rro" ]; then ver=3
		elif [ -e "$d/rxinfo" ]; then ver=2
		else ver=null
		fi
		if [ -s "$d/txinfo" ] || [ -n "$(head -c 1 "$d/txinfo" 2>/dev/null)" ]; then
			attached=true
		else
			attached=false
		fi
		# Receive offload, and with it the WO firmware, runs only where the
		# driver asked for it (mtk_wed_get_rx_capa(); never on v1); its
		# buffer manager base is set up then, so a zero base is a TX-only
		# WED. A dump that cannot be read, or has no such base, leaves it
		# unknown (null).
		rx=false
		if [ $attached = true ] && [ $ver != 1 ]; then
			rx=null
			while read -r k v rest; do
				[ "$k" = WED_RX_BM_BASE ] || continue
				case "$v" in *[!0-9a-fA-F]*|'') ;; *[1-9a-fA-F]*) rx=true ;; *) rx=false ;; esac
				break
			done 2>/dev/null < "$d/rxinfo"
		fi
		wo=
		case "$recs" in *"$NL$id|"*) wo=${recs#*"$NL$id|"}; wo=${wo%%"$NL"*} ;; esac
		[ $first -eq 1 ] || out="$out,"
		first=0
		wo_json "$wo"
		out="$out{\"id\":$id,\"version\":$ver,\"attached\":$attached,\"rx\":$rx,$WJ}"
	done
	wo_json "$fw"
	printf '"wed":[%s],%s' "$out" "$WJ"
}

# wo_json <version>|<build>: the two JSON members in $WJ; no "|", no build.
wo_json() {
	local ver build=
	js "${1%%|*}"; ver=$JS
	case "$1" in *"|"*) js "${1#*|}"; build=$JS ;; esac
	WJ="\"wo_firmware\":\"$ver\",\"wo_build\":\"$build\""
}

# ── Flow offload ────────────────────────────────────────────────────────

# fw_bool <value>: true where firewall4 reads the option as true
# (parse_bool in fw4.uc); anything else is false or falls back to off.
fw_bool() {
	case "$1" in 1|on|true|yes) return 0 ;; esac
	return 1
}

flow_json() {
	local fo foh sw=false hw=false
	fo=$(uci -q get firewall.@defaults[0].flow_offloading)
	foh=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
	fw_bool "$fo" && { sw=true; fw_bool "$foh" && hw=true; }
	printf '"flow_offload":{"software":%s,"hardware":%s}' "$sw" "$hw"
}

get_status() {
	local skip_ppe soc
	skip_ppe=$(json_input "$1" skip_ppe)
	rd "$R/tmp/sysinfo/model"; js "$RD"
	printf '{"model":"%s",' "$JS"
	js "$(board_compatible)"; printf '"compatible":"%s",' "$JS"
	soc=$(soc_compatible)
	js "$soc"; printf '"soc":"%s",' "$JS"
	cpu_json; printf ','
	# The page gets these counters from the same snapshot as its flow rows.
	if [ "$skip_ppe" = true ]; then printf '"ppe":[]'; else ppe_json; fi
	printf ','; wed_json "$soc"
	printf ','; wed_param_json
	printf ','; flow_json
	printf '}'
}

# ── Ports ───────────────────────────────────────────────────────────────

# GDM index of an mtk_soc_eth netdev: mtk_add_mac() points the netdev's
# of_node at the mac@N child, and N is the GDM id.
gdm_of() {
	# gdm_of <sysfs dir>: the GDM index in $GDM, empty for other netdevs.
	local l
	GDM=
	l=$(readlink "$1/of_node" 2>/dev/null)
	case "$l" in *mac@[0-9]*) l=${l##*mac@}; GDM=${l%%[!0-9]*} ;; esac
}

# A DSA user port: the kernel tags it DEVTYPE=dsa (SET_NETDEV_DEVTYPE in
# net/dsa/user.c) and its iflink is the conduit's ifindex. DSA has no
# phys_port_name on current kernels, so that attribute cannot be used.
is_dsa_user() {
	# is_dsa_user <sysfs dir> <iflink>
	local c l
	if [ -r "$1/uevent" ]; then
		while IFS= read -r l; do
			[ "$l" = DEVTYPE=dsa ] && return 0
		done < "$1/uevent"
	fi
	rd "$1/ifindex"
	[ -n "$2" ] && [ "$2" != "$RD" ] || return 1
	for c in "$R"/sys/class/net/*; do
		rd "$c/ifindex"
		[ "$RD" = "$2" ] && [ -r "$c/dsa/tagging" ] && return 0
	done
	return 1
}

# The physical port under a WAN device: a VLAN (eth2.35, or a named 8021q
# device) links to its parent as lower_<dev> in sysfs.
wan_ports() {
	# wan_ports <netdev> [depth]: append the ports under it to $WP. VLANs,
	# bridges and bonds link their members as lower_<dev>; follow them down
	# to netdevs that are ports themselves (a device or of_node). DSA user
	# ports stop there, though they list their conduit as a lower device.
	local d="$1" depth="${2:-0}" l found=0
	[ -n "$d" ] && [ "$depth" -lt 6 ] || return 0
	if [ ! -d "$R/sys/class/net/$d" ]; then
		# Not created yet: a VLAN name still points at its port.
		case "$d" in
			*.*) wan_ports "${d%.*}" $((depth + 1)) ;;
			*) WP="$WP $d " ;;
		esac
		return 0
	fi
	if [ -e "$R/sys/class/net/$d/device" ] || [ -e "$R/sys/class/net/$d/of_node" ]; then
		WP="$WP $d "
		return 0
	fi
	for l in "$R/sys/class/net/$d"/lower_*; do
		[ -e "$l" ] || continue
		found=1
		wan_ports "${l##*/lower_}" $((depth + 1))
	done
	[ $found = 1 ] || WP="$WP $d "
	return 0
}

# Highest speed a port supports, for a label that does not change with the
# link: ethtool's supported link modes when installed, otherwise the DT
# phy-mode. "internal" is the 2.5G PHY on an MT7987/MT7988 GMAC and a 1G PHY
# on a switch port.
port_max_mbps_probe() {
	# port_max_mbps <sysfs dir> <kind>: the speed in $PM
	local m mode=
	if command -v ethtool >/dev/null 2>&1; then
		m=$(ethtool "${1##*/}" 2>/dev/null | awk '
			/Supported link modes:/ { f = 1; sub(/.*:/, "") }
			f && /:/ { f = 0 }
			f { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+base/) { v = $i + 0; if (v > m) m = v } }
			END { print m + 0 }')
		[ "${m:-0}" -gt 0 ] && { PM=$m; return; }
	fi
	# A DT string property ends in NUL; read drops it.
	for m in phy-mode phy-connection-type; do
		[ -r "$1/of_node/$m" ] && { rd "$1/of_node/$m"; mode=$RD; break; }
	done
	case "$mode" in
		usxgmii|10gbase-r|10gbase-kr|xaui|rxaui) m=10000 ;;
		5gbase-r) m=5000 ;;
		2500base-x) m=2500 ;;
		internal) if [ "$2" = gdm ]; then m=2500; else m=1000; fi ;;
		sgmii|qsgmii|1000base-x|1000base-kx|gmii|rgmii*|trgmii) m=1000 ;;
		'') if [ "$2" = gsw ]; then m=1000; else m=null; fi ;;
		*) m=null ;;
	esac
	PM=$m
}

port_max_mbps() {
	local identity stamp cached_id cached_kind cached_speed tmp
	local cache="$STATE/port-${1##*/}.max"
	rd "$1/ifindex"; identity=$RD
	clock_now
	if [ -n "$NOW" ] && [ -n "$identity" ] && [ -r "$cache" ]; then
		read -r stamp cached_id cached_kind cached_speed < "$cache"
		case "$stamp:$cached_speed" in
			*[!0-9:]*|:*|*:) ;;
			*) if [ "$cached_id" = "$identity" ] && [ "$cached_kind" = "$2" ] &&
				[ "$NOW" -ge "$stamp" ] && [ $((NOW - stamp)) -lt 60 ]; then
				PM=$cached_speed; return
			fi ;;
		esac
	fi
	port_max_mbps_probe "$1" "$2"
	# Unknown capabilities are retried, not pinned during device startup.
	case "$PM" in ''|*[!0-9]*) return ;; esac
	[ -n "$NOW" ] && [ -n "$identity" ] || return 0
	tmp=$(mktemp "$cache.XXXXXX") || return 0
	printf '%s %s %s %s\n' "$NOW" "$identity" "$2" "$PM" > "$tmp" &&
		mv -f "$tmp" "$cache" || rm -f "$tmp"
}

port_json() {
	# port_json <sysfs dir> <role> <kind> <gdm> <conduit>: the object in $PJ
	local n="$1" speed carrier name conduit duplex k stats=
	ri "$n/carrier" null; carrier=$RI
	ri "$n/speed" null; speed=$RI
	[ "$carrier" = 1 ] || speed=null
	js "${n##*/}"; name=$JS
	js "$5"; conduit=$JS
	rd "$n/duplex"; js "$RD"; duplex=$JS
	port_max_mbps "$n" "$3"
	for k in rx_bytes tx_bytes rx_packets tx_packets rx_errors tx_errors rx_dropped tx_dropped; do
		ri "$n/statistics/$k" null
		stats="$stats,\"$k\":$RI"
	done
	PJ="{\"netdev\":\"$name\",\"role\":\"$2\",\"kind\":\"$3\",\"gdm\":${4:-null},\"conduit\":\"$conduit\",\"carrier\":$carrier,\"speed_mbps\":$speed,\"max_mbps\":$PM,\"duplex\":\"$duplex\"$stats}"
}

get_ports() {
	local wan n i c drv gdm role kind conduit out="" first=1 iflink
	WP=
	wan_ports "$(uci -q get network.wan.device)"
	wan_ports "$(uci -q get network.wan6.device)"
	wan=$WP
	for n in "$R"/sys/class/net/*; do
		i=${n##*/}
		[ -e "$n/device" ] || [ -e "$n/of_node" ] || continue
		gdm=""; conduit=""
		rd "$n/iflink"; iflink=$RD
		if is_dsa_user "$n" "$iflink"; then
			kind=gsw
			for c in "$R"/sys/class/net/*; do
				rd "$c/ifindex"
				[ "$RD" = "$iflink" ] && { conduit=${c##*/}; gdm_of "$c"; gdm=$GDM; break; }
			done
		else
			gdm_of "$n"; gdm=$GDM
			if [ -z "$gdm" ]; then
				drv=$(readlink "$n/device/driver" 2>/dev/null)
				[ "${drv##*/}" = mtk_soc_eth ] || continue
			fi
			kind=gdm
		fi
		case "$wan" in *" $i "*) role=wan ;; *) role=lan ;; esac
		# A DSA conduit only feeds the switch; it is not a user-facing port.
		[ "$kind" = gdm ] && [ -r "$n/dsa/tagging" ] && role=conduit
		[ $first -eq 1 ] || out="$out,"
		first=0
		port_json "$n" "$role" "$kind" "$gdm" "$conduit"
		out="$out$PJ"
	done
	printf '{"compatible":"%s","model":"%s","ports":[%s]}' \
		"$(json_str "$(board_compatible)")" "$(json_str "$(read_first "$R/tmp/sysinfo/model")")" "$out"
}

# GDM MAC counters from ethtool -S (mtk_ethtool_stats[] in mtk_eth_soc.c).
get_mac_stats() {
	local n i gdm out="" first=1
	if ! command -v ethtool >/dev/null 2>&1; then
		printf '{"available":false,"reason":"ethtool_missing","macs":[]}'
		return
	fi
	for n in "$R"/sys/class/net/*; do
		i=${n##*/}
		gdm_of "$n"; gdm=$GDM
		[ -n "$gdm" ] || continue
		[ $first -eq 1 ] || out="$out,"
		first=0
		# The name is escaped here: awk -v would also read its backslashes.
		js "$i"
		out="$out{\"netdev\":\"$JS\",\"gdm\":$gdm$(ethtool -S "$i" 2>/dev/null | awk '
			BEGIN { split("tx_bytes tx_packets tx_skip tx_collisions rx_bytes rx_packets rx_overflow rx_fcs_errors rx_short_errors rx_long_errors rx_checksum_errors rx_flow_control_packets", k, " ") }
			{ gsub(/^[ \t]+|:$/, "", $1); key = $1; sub(/:$/, "", key); v[key] = $2 }
			END { for (j = 1; j in k; j++) printf ",\"%s\":%s", k[j], (k[j] in v ? v[k[j]] + 0 : "null") }')}"
	done
	printf '{"available":true,"macs":[%s]}' "$out"
}

# ── Wi-Fi ───────────────────────────────────────────────────────────────
# Per-band client health from iw, same computation as luci-app-airoha-npu.

# Normalize one interface and its stations. iw prints top-level statistics
# followed by per-link statistics for an MLO station; only one level is used.
# I = band/interface, U = unique station, C = counters, P = incomplete mapping.
wifi_records() {
	# The interface name is data on stdin: awk -v would decode backslashes.
	printf '%s\n%s\n#STATIONS\n%s\n' "$1" "$2" "$3" | awk '
		function band(f) { return f >= 5925 ? 2 : f >= 5000 ? 1 : 0 }
		function value(s, k) { return ((s SUBSEP k) in v) ? v[s, k] : "-" }
		function emit(s, b, key,   ct) {
			ct = value(s, "ct"); if (ct == "-") ct = value("top", "ct")
			print "C", b, iface, key, value(s, "tx"), ct, value(s, "pk"),
				value(s, "rt"), value(s, "fl"), value(s, "phy"), value(s, "ex"), value(s, "sig")
		}
		function flush_station(   l) {
			if (mac == "") return
			print "U", iface, mac
			if (have_links) {
				for (l in links) {
					if (!(l in bands)) { print "P"; continue }
					emit(l, bands[l], mac "/" l "/" ((l in addresses) ? addresses[l] : "-"))
				}
			} else if (band_count == 1 && !unmapped) emit("top", only_band, mac)
			else print "P"
		}
		NR == 1 { iface = $0; next }
		!stations && $0 == "#STATIONS" {
			stations = 1
			if (!mlo && have_channel) active[default_band] = 1
			for (b = 0; b < 3; b++) if (b in active) { print "I", b, iface; band_count++; only_band = b }
			for (l in configured) if (!(l in bands)) unmapped = 1
			next
		}
		!stations {
			if ($1 == "MLD" && $2 == "with" && $3 == "links:") { mlo = 1; id = "" }
			if ($1 == "-" && $2 == "link") {
				mlo = 1; id = ""
				if ($3 == "ID" && $4 ~ /^[0-9]+$/) { id = $4 + 0; configured[id] = 1 }
				else unmapped = 1
			}
			if ($1 == "channel") {
				f = $3; sub(/^\(/, "", f)
				if (f ~ /^[0-9]+$/ && f + 0 > 1000) {
					if (mlo && id != "") { bands[id] = band(f); active[bands[id]] = 1 }
					else if (!mlo) { have_channel = 1; default_band = band(f) }
				}
			}
			next
		}
		/^Station / {
			flush_station(); delete v; delete links; delete addresses
			mac = $2; section = "top"; have_links = 0; next
		}
		mac == "" { next }
		$1 == "Link" && $2 ~ /^[0-9]+:$/ {
			section = $2; sub(/:$/, "", section); section += 0
			links[section] = 1; have_links = 1; next
		}
		$1 == "address:" && section != "top" { addresses[section] = $2; next }
		$1 == "tx" && $3 ~ /^[0-9]+$/ {
			if ($2 == "bytes:") v[section, "tx"] = $3
			else if ($2 == "packets:") v[section, "pk"] = $3
			else if ($2 == "retries:") v[section, "rt"] = $3
			else if ($2 == "failed:") v[section, "fl"] = $3
		}
		$1 == "connected" && $2 == "time:" && $3 ~ /^[0-9]+$/ { v[section, "ct"] = $3 }
		$1 == "tx" && $2 == "bitrate:" && $3 + 0 > 0 { v[section, "phy"] = $3 + 0 }
		$1 == "expected" && $2 == "throughput:" && $3 + 0 > 0 { v[section, "ex"] = $3 + 0 }
		$1 == "signal" && $2 == "avg:" && $3 ~ /^-[0-9]+$/ { v[section, "sig"] = $3 }
		END { flush_station() }
	'
}

get_wifi_stats() {
	local iface records d now end rest late rates snap list info prev f try body old partial=0 hw cur=""
	hw=$([ -n "$(ls "$R"/sys/class/ieee80211 2>/dev/null)" ] && echo true || echo false)
	if ! command -v iw >/dev/null 2>&1; then
		printf '{"available":false,"has_wifi":%s,"bands":[]}' "$hw"
		return
	fi
	read -r now rest < "$R/proc/uptime" 2>/dev/null
	list=$(iw dev 2>/dev/null) ||
		{ printf '{"available":false,"has_wifi":%s,"error":"iw dev failed","bands":[]}' "$hw"; return; }
	# "Interface" and "type" are the first words of their lines; the SSID
	# line in between may contain the same words. AP/VLAN carries the WDS
	# stations of an AP.
	list=$(printf '%s\n' "$list" | awk '
		$1 == "Interface" { i = $2; next }
		$1 == "type" {
			if (($2 == "AP" || $2 == "AP/VLAN") && i != "" && !(i in seen)) { seen[i]; print i }
			i = ""
		}') || { printf '{"available":false,"has_wifi":%s,"error":"cannot parse Wi-Fi interfaces","bands":[]}' "$hw"; return; }
	# Valid interface names can contain glob characters and backslashes.
	while IFS= read -r iface; do
		[ -n "$iface" ] || continue
		# A failed query leaves the sample incomplete: it is reported and
		# never becomes the rate baseline.
		info=$(iw dev "$iface" info 2>/dev/null) || { partial=1; continue; }
		d=$(iw dev "$iface" station dump 2>/dev/null) || { partial=1; continue; }
		records=$(wifi_records "$iface" "$info" "$d") || { partial=1; continue; }
		cur="$cur$records$NL"
	done <<EOF
$list
EOF
	case "$NL$cur$NL" in *"${NL}P${NL}"*) partial=1 ;; esac

	read -r end rest < "$R/proc/uptime" 2>/dev/null
	# The sample (time, rates, per-client TX bytes) is shared by every open
	# page. A rate adds up the growth of clients present in both samples, so
	# clients leaving or joining do not swing it. A sample taken less than
	# WIFI_MIN_DT after the newest one, older than it, incomplete or read
	# over more than WIFI_MAX_SPAN returns the stored rates and is not kept.
	prev=
	for try in 1 2 3; do
		# A newer writer may prune the file just picked; pick again.
		f=
		for prev in "$WIFI_SNAP"/[0-9]*; do [ -f "$prev" ] && f=$prev; done
		prev=
		[ -n "$f" ] || break
		prev=$(cat "$f" 2>/dev/null) && [ -n "$prev" ] && break
		prev=
	done
	snap=$(printf '%s\n%s' "$prev" "$cur" | awk -v now="${now:-0}" -v end="${end:-${now:-0}}" -v span="$WIFI_MAX_SPAN" \
		-v min="$WIFI_MIN_DT" -v partial="$partial" '
		# T <start> <rates> <end>: counters were read between start and end
		$1 == "T" { pt = $2; pr[0] = $3; pr[1] = $4; pr[2] = $5; pe = ($6 != "" ? $6 : $2); next }
		$1 == "S" { k = $3 " " $4; ptx[k] = $5; pb[k] = $2; next }
		$1 == "C" && $5 ~ /^[0-9]+$/ { k = $3 " " $4; ctx[k] = $5; cb[k] = $2; cct[k] = $6; next }
		END {
			late = end - now > span
			r[0] = r[1] = r[2] = "0.0"; save = !partial && !late
			if (pt > 0) {
				dt = now - pt
				if (partial || late || dt < min) {
					save = 0; r[0] = pr[0]; r[1] = pr[1]; r[2] = pr[2]
				} else {
					# The two reads of a client lie at least gap apart, and
					# "connected time" is whole seconds: only a session a
					# full second shorter than gap surely began after the
					# last read (a reconnect). Counting an unsure one cannot
					# overstate the rate, its counter restarted.
					gap = now - pe
					for (k in ctx) {
						if (!(k in ptx) || pb[k] != cb[k] || (cct[k] != "-" && cct[k] + 1 <= gap)) continue
						d = ctx[k] - ptx[k]
						if (d > 0) s[cb[k]] += d
					}
					for (b = 0; b < 3; b++) r[b] = sprintf("%.1f", s[b] / dt / 125000)
				}
			}
			print r[0], r[1], r[2], late
			if (save) {
				printf "%012.0f\n", now * 100
				printf "T %s %s %s %s %s\n", now, r[0], r[1], r[2], end
				for (k in ctx) printf "S %s %s %s\n", cb[k], k, ctx[k]
			}
		}')
	rates=${snap%%"$NL"*}
	case "$snap" in
		*"$NL"*)
			body=${snap#*"$NL"}
			f=${body%%"$NL"*}
			body=${body#*"$NL"}
			mkdir -p "$WIFI_SNAP" 2>/dev/null
			if printf '%s\n' "$body" 2>/dev/null > "$WIFI_SNAP/.$$" &&
				mv -f "$WIFI_SNAP/.$$" "$WIFI_SNAP/$f" 2>/dev/null; then
				# Keep the three newest: a reader that picked one a moment
				# ago can still open it.
				set -- "$WIFI_SNAP"/[0-9]*
				old=''
				while [ $# -gt 3 ]; do old="$old $1"; shift; done
				# shellcheck disable=SC2086
				[ -z "$old" ] || rm -f $old
			else
				# No stored sample means no baseline for the next rate.
				rm -f "$WIFI_SNAP/.$$"
				partial=1
			fi
			;;
	esac

	local rate0 rate1 rate2
	read -r rate0 rate1 rate2 late <<EOF
$rates
EOF
	# A sample read too slowly is reported like a partial one.
	[ "$late" = 1 ] && partial=1
	printf '%s\n' "$cur" | awk -v partial="$partial" -v r0="${rate0:-0}" -v r1="${rate1:-0}" -v r2="${rate2:-0}" "$JESC_AWK"'
		$1 == "I" {
			b = $2; k = b " " $3
			if (!(k in interfaces)) { interfaces[k] = 1; ifs[b] = ifs[b] (ifs[b] == "" ? "" : " ") $3 }
		}
		$1 == "U" { clients[$2 " " $3] = 1 }
		$1 == "C" {
			b = $2; split($4, station, "/"); k = b " " $3 " " station[1]
			if (!(k in seen)) { seen[k] = 1; st[b]++ }
			pk[b] += $7; rt[b] += $8; fl[b] += $9
			if ($10 + 0 > 0) { phy[b] += $10; pn[b]++ }
			if ($11 + 0 > 0) { ex[b] += $11; en[b]++ }
			if ($12 != "-") { ss[b] += $12; sn[b]++; if (sn[b] == 1 || $12 + 0 < mn[b]) mn[b] = $12 + 0 }
		}
		END {
			for (k in clients) total++
			printf "{\"available\":true,\"has_wifi\":true,\"complete\":%s,\"stations\":%d,\"bands\":[", (partial ? "false" : "true"), total
			for (b = 0; b < 3; b++) {
				if (!(b in ifs)) continue
				ap = pn[b] ? phy[b] / pn[b] : 0; ae = en[b] ? ex[b] / en[b] : 0
				printf "%s{\"band\":%d,\"interfaces\":\"%s\",\"stations\":%d,\"tx_packets\":%.0f,\"tx_retries\":%.0f,\"tx_failed\":%.0f,\"avg_phy_rate\":%.1f,\"avg_exp_throughput\":%.1f,\"airtime_efficiency\":%d,\"avg_signal\":%d,\"min_signal\":%d,\"tx_mbps\":%s}",
					(n++ ? "," : ""), b, jesc(ifs[b]), st[b], pk[b], rt[b], fl[b], ap, ae,
					(ap > 0 ? int(ae / ap * 100) : 0), (sn[b] ? int(ss[b] / sn[b]) : 0), mn[b], (b == 0 ? r0 : b == 1 ? r1 : r2)
			}
			printf "]}"
		}'
}

# ── Setters ─────────────────────────────────────────────────────────────

# Seconds a save waits for another one to finish.
SETTINGS_LOCK_WAIT=10

# locked <setter> <input>: run setters one at a time, from their checks to
# the commit, so two pages saving at once cannot leave the applied settings
# from one request and the saved ones from the other. The lock is on fd 4.
locked() {
	local i=0 rc
	{
		while :; do
			flock -n 4 && break
			rc=$?
			[ $rc = 1 ] || { printf '{"error":"cannot lock the settings"}'; return 0; }
			[ $i -lt $SETTINGS_LOCK_WAIT ] || { printf '{"error":"another save is in progress"}'; return 0; }
			i=$((i + 1))
			sleep 1
		done
		"$@"
		return 0
	} 4> "$STATE/settings.lock" || printf '{"error":"cannot lock the settings"}'
}

set_flow_offload() {
	local en
	en=$(json_input "$1" enabled)
	case "$en" in 0|1) ;; *) printf '{"error":"enabled must be 0 or 1"}'; return ;; esac
	# Hardware offload rides on the software flowtable, so enabling it turns
	# both on; disabling only drops the hardware part.
	{ [ "$en" = 0 ] || uci -q set firewall.@defaults[0].flow_offloading=1; } &&
		uci -q set firewall.@defaults[0].flow_offloading_hw="$en" &&
		uci -q commit firewall ||
		{ printf '{"error":"cannot save the firewall settings"}'; return; }
	# fw4 rebuilds its flowtable on reload; only a finished reload applies it.
	# Nothing it starts may inherit the settings lock.
	"$R/etc/init.d/firewall" reload >/dev/null 2>&1 4>&- ||
		{ printf '{"error":"saved, but reloading the firewall failed"}'; return; }
	printf '{"result":"ok","enabled":%s}' "$en"
}

# Rewrite one module configuration file. Autoload entries must keep the
# module name even when wed_enable was their only argument. modules.conf gets
# the one canonical value; boot and normal autoload then inherit that value.
wed_rewrite() {
	awk -v mod="$1" -v val="$2" -v conf="$3" "$KARGS_AWK$WED_LINES_AWK"'
		{
			if (!wed_line($0, conf)) { print; next }
			n = kargs(WA_ARGS, t); rest = ""; hit = 0
			for (j = 1; j <= n; j++) {
				karg(t[j])
				if (KN == "wed_enable") hit = 1; else rest = rest " " t[j]
			}
			if (!hit) { print; next }
			if (!conf || rest != "") print WA_PREFIX rest (WA_SUFFIX != "" ? " " WA_SUFFIX : "")
			else if (WA_SUFFIX != "") print WA_SUFFIX
		}
		END { if (conf) print "options " mod " wed_enable=" val }
		' "$4"
}

# Stage all affected files before replacing any. The temporary files are
# hidden in the destination directory: rename/rollback stay on one filesystem,
# and kmodloader never mistakes a leftover staging file for an autoload entry.
wed_stage() {
	local mod="$1" val="$2" f target conf tmp old step seen="$NL" i=0
	set -- "$MODCONF" "$R"/etc/modules-boot.d/* "$R"/etc/modules.d/*
	for f in "$@"; do
		conf=0
		if [ "$f" = "$MODCONF" ]; then
			conf=1
			[ ! -e "$f" ] || [ -f "$f" ] || return 1
		else
			[ -f "$f" ] || continue
		fi
		target=$(readlink -f "$f") || return 1
		case "$target" in ''|*"$NL"*) return 1 ;; esac
		case "$seen" in *"$NL$target$NL"*) continue ;; esac
		seen="$seen$target$NL"
		if [ -f "$target" ]; then
			# A quote spanning lines/files cannot be rewritten independently.
			# Reject it before installing any file; preserve unrelated entries.
			awk -v mod="$mod" -v conf="$conf" "$KARGS_AWK$WED_LINES_AWK"'
				wed_line($0, conf) {
					q = WA_ARGS
					if (gsub(/"/, "", q) % 2) { unclosed = 1; exit }
					n = kargs(WA_ARGS, t)
					for (j = 1; j <= n; j++) { karg(t[j]); if (KN == "wed_enable") hit = 1 }
				}
				END { if (unclosed) exit 11; if (hit) exit 10 }
				' "$target" >/dev/null 2>&1
			case "$?" in
				0) [ "$conf" = 1 ] || continue ;;
				10) ;;
				11) WED_STAGE_ERROR='cannot safely save WED settings with quotes spanning lines or files'; return 1 ;;
				*) return 1 ;;
			esac
		fi
		i=$((i + 1)); step="$WED_TXN/$i"
		mkdir "$step" || return 1
		printf '%s\n' "$target" > "$step/path" || return 1
		tmp=$(mktemp "${target%/*}/.mtkw-new.XXXXXX") || return 1
		printf '%s\n' "$tmp" > "$step/new" || { rm -f "$tmp"; return 1; }
		if [ -f "$target" ]; then
			old=$(mktemp "${target%/*}/.mtkw-old.XXXXXX") || return 1
			printf '%s\n' "$old" > "$step/old" || { rm -f "$old"; return 1; }
			cp -p "$target" "$old" && cp -p "$target" "$tmp" || return 1
			wed_rewrite "$mod" "$val" "$conf" "$target" > "$tmp" || return 1
		else
			chmod 0644 "$tmp" || return 1
			wed_rewrite "$mod" "$val" "$conf" /dev/null > "$tmp" || return 1
		fi
	done
}

wed_cleanup() {
	local step file
	for step in "$WED_TXN"/*; do
		[ -d "$step" ] || continue
		for file in new old; do rd "$step/$file"; [ -z "$RD" ] || rm -f "$RD"; done
	done
	rm -rf "$WED_TXN"
}

set_wed_enable() {
	local en mod val=N step target tmp old index applied= failed=0 restore_failed=0 WED_TXN
	local WED_STAGE_ERROR='cannot prepare the WED settings'
	en=$(json_input "$1" enabled)
	case "$en" in 0|1) ;; *) printf '{"error":"enabled must be 0 or 1"}'; return ;; esac
	[ "$en" = 1 ] && val=Y
	mod=$(wed_module)
	WED_TXN=$(mktemp -d "$STATE/wed-save.XXXXXX") ||
		{ printf '{"error":"cannot prepare the WED settings"}'; return; }
	if ! wed_stage "$mod" "$val"; then
		wed_cleanup
		printf '{"error":"%s"}' "$WED_STAGE_ERROR"
		return
	fi
	for step in "$WED_TXN"/*; do
		rd "$step/path"; target=$RD
		rd "$step/new"; tmp=$RD
		if ! mv -f "$tmp" "$target"; then failed=1; break; fi
		# Tracking successful renames must not depend on another file write.
		applied="${step##*/} $applied"
	done
	if [ "$failed" = 1 ]; then
		for index in $applied; do
			step="$WED_TXN/$index"
			rd "$step/path"; target=$RD
			rd "$step/old"; old=$RD
			if [ -n "$old" ]; then mv -f "$old" "$target" || restore_failed=1
			else rm -f "$target" || restore_failed=1
			fi
		done
		if [ "$restore_failed" = 1 ]; then
			# Keep the originals and path mappings if a restore also failed.
			js "$WED_TXN"
			printf '{"error":"cannot save or restore the WED settings; recovery files: %s"}' "$JS"
		else
			wed_cleanup
			printf '{"error":"cannot save the WED settings; previous settings restored"}'
		fi
		return
	fi
	wed_cleanup
	printf '{"result":"ok","enabled":%s,"module":"%s","reboot_required":true}' "$en" "$mod"
}

set_cpu_settings() {
	local gov freq p ok_gov=0 ok_freq=0 f failed=0
	gov=$(json_input "$1" governor)
	freq=$(json_input "$1" freq)
	p=$(cpu_policy)
	[ -n "$p" ] || { printf '{"error":"cpufreq unavailable"}'; return; }
	for f in $(read_first "$p/scaling_available_governors"); do [ "$f" = "$gov" ] && ok_gov=1; done
	for f in $(read_first "$p/scaling_available_frequencies"); do [ "$f" = "$freq" ] && ok_freq=1; done
	[ $ok_gov = 1 ] || { printf '{"error":"unsupported governor"}'; return; }
	[ $ok_freq = 1 ] || { printf '{"error":"unsupported frequency"}'; return; }
	for p in "$R"/sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$p" ] || continue
		echo "$gov" 2>/dev/null > "$p/scaling_governor" || failed=1
		echo "$freq" 2>/dev/null > "$p/scaling_max_freq" || failed=1
	done
	[ $failed = 0 ] || { printf '{"error":"cannot apply the CPU settings"}'; return; }
	uci -q set mtk_wed.cpu=cpu &&
		uci -q set mtk_wed.cpu.governor="$gov" &&
		uci -q set mtk_wed.cpu.max_freq="$freq" &&
		uci -q commit mtk_wed ||
		{ printf '{"error":"applied, but saving the CPU settings failed"}'; return; }
	printf '{"result":"ok","governor":"%s","freq":%s}' "$gov" "$freq"
}

case "$1" in
	list)
		printf '{"getStatus":{"skip_ppe":true},"getPorts":{},"getPpeEntries":{"page":0,"state":"","type":"","ppe":"","refresh":true,"interval":0},"getMacStats":{},"getWifiStats":{},"setFlowOffload":{"enabled":0},"setWedEnable":{"enabled":0},"setCpuSettings":{"governor":"","freq":0}}'
		;;
	call)
		[ -d "$STATE" ] || mkdir -p -m 0700 "$STATE" 2>/dev/null
		case "$2" in
			getStatus) read -r input; get_status "$input" ;;
			getPorts) get_ports ;;
			getPpeEntries) read -r input; get_ppe_entries "$input" ;;
			getMacStats) get_mac_stats ;;
			getWifiStats) get_wifi_stats ;;
			setFlowOffload) read -r input; locked set_flow_offload "$input" ;;
			setWedEnable) read -r input; locked set_wed_enable "$input" ;;
			setCpuSettings) read -r input; locked set_cpu_settings "$input" ;;
			*) printf '{"error":"unknown method"}' ;;
		esac
		;;
esac
