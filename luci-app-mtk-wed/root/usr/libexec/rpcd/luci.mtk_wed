#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# rpcd backend for luci-app-mtk-wed: hardware offload status for MediaTek
# Filogic SoCs (MT7981, MT7986, MT7987, MT7988) on the mainline kernel.
#
# Data sources (kernel 6.18, mt76 467ae2e):
#   /sys/kernel/debug/ppeN/{entries,bind}  mtk_ppe_debugfs.c, one dir per PPE
#                                          (two on MT7981/6/7, three on MT7988)
#   /sys/kernel/debug/wedN/{txinfo,...}    mtk_wed_debugfs.c; txinfo is empty
#                                          while no WLAN device is attached
#   /sys/module/<mod>/parameters/wed_enable   mt76 module parameter of
#                                          mt7915e or mt7996e
#   /etc/modules.conf                      "options <mod> wed_enable=Y" makes
#                                          the parameter survive a reboot
#
# MTKW_ROOT prefixes every filesystem path; it is empty on a router and only
# set by the test harness.

R="${MTKW_ROOT:-}"
DBG="$R/sys/kernel/debug"
MODCONF="$R/etc/modules.conf"
FW_CONF="$R/etc/config/firewall"
FW_INIT="$R/etc/init.d/firewall"
FW4_STATE="$R/var/run/fw4.state"
FW4_LOCK="$R/var/run/fw4.lock"
# Samples and caches live in a directory only root can create: unprivileged
# daemons can write to /tmp but not to /var/run, so none of these names can
# be planted there as a FIFO, a symlink or forged data.
STATE="$R/var/run/mtk-wed"
# One file per Wi-Fi sample, named by its uptime in centiseconds; readers
# take the newest, so a slow writer can never roll the sample back.
WIFI_SNAP="$STATE/wifi"
WIFI_MIN_DT=2
# Seconds the iw reads of one sample may take: its counters carry the time
# taken before them, so a slower sample cannot be placed in time.
WIFI_MAX_SPAN=1
NL='
'
PPE_MAX_ENTRIES=1000
PPE_LOCK_WAIT="${PPE_LOCK_WAIT:-10}"
UCI_LOCK_WAIT="${UCI_LOCK_WAIT:-10}"
UCI_CAS_TRIES="${UCI_CAS_TRIES:-5}"
FW_RELOAD_WAIT="${FW_RELOAD_WAIT:-10}"
case "$PPE_LOCK_WAIT" in ''|*[!0-9]*|0?*) PPE_LOCK_WAIT=10 ;; esac
case "$UCI_LOCK_WAIT" in ''|*[!0-9]*|0?*) UCI_LOCK_WAIT=10 ;; esac
case "$UCI_CAS_TRIES" in ''|*[!0-9]*|0|0?*) UCI_CAS_TRIES=5 ;; esac
case "$FW_RELOAD_WAIT" in ''|*[!0-9]*|0|0?*) FW_RELOAD_WAIT=10 ;; esac
CLEANUP_PATHS=
CLEANUP_WED_TXN=
CLEANUP_WED_COMMITTING=0
CLEANUP_WED_REV_STEPS=
CLEANUP_CPU_TXN=
CLEANUP_CPU_APPLIED=
CLEANUP_CPU_COMMITTING=0
CLEANUP_CPU_GOV=
CLEANUP_CPU_FREQ=
CLEANUP_RPCD_SID=
CLEANUP_FLOW_APPLY=
CLEANUP_FLOW_MANUAL=0

rpcd_session_destroy() {
	[ -n "$CLEANUP_RPCD_SID" ] || return 0
	# Interrupted after dispatching a checked apply. Only its owning SID
	# can roll it back. The daemon also has an independent rollback timer.
	if [ -n "$CLEANUP_FLOW_APPLY" ]; then
		ubus -S call uci rollback "{\"ubus_rpc_session\":\"$CLEANUP_RPCD_SID\"}" >/dev/null 2>&1 4>&- 7<&- || true
		if [ "$CLEANUP_FLOW_MANUAL" = 1 ]; then
			"$FW_INIT" reload >/dev/null 2>&1 4>&- 7<&-
		fi
		CLEANUP_FLOW_APPLY=
		CLEANUP_FLOW_MANUAL=0
	fi
	ubus call session destroy "{\"ubus_rpc_session\":\"$CLEANUP_RPCD_SID\"}" >/dev/null 2>&1 4>&- 7<&-
	CLEANUP_RPCD_SID=
}

cleanup_add() {
	[ -n "$1" ] || return 0
	CLEANUP_PATHS="$CLEANUP_PATHS$1$NL"
}

cleanup_del() {
	local p="$1" line rest=
	[ -n "$p" ] && [ -n "$CLEANUP_PATHS" ] || return 0
	while IFS= read -r line; do
		[ -n "$line" ] && [ "$line" != "$p" ] && rest="$rest$line$NL"
	done <<EOF
$CLEANUP_PATHS
EOF
	CLEANUP_PATHS=$rest
}

cleanup_on_exit() {
	local p cpu_phase WED_RESTORE_FAILED=0 CPU_RESTORE_FAILED=0
	trap - EXIT INT TERM HUP
	rpcd_session_destroy
	if [ -n "$CLEANUP_WED_TXN" ]; then
		WED_TXN=$CLEANUP_WED_TXN
		if [ "$CLEANUP_WED_COMMITTING" = 1 ]; then
			CLEANUP_WED_COMMITTING=0
			rd "$WED_TXN/state"
			if [ "$RD" = committed ]; then
				wed_cleanup
			else
				wed_restore
				if [ "$WED_RESTORE_FAILED" = 1 ]; then
					wed_write_state "$WED_TXN" restore_failed
					CLEANUP_WED_TXN=
					CLEANUP_WED_REV_STEPS=
				else
					wed_cleanup
				fi
			fi
		else
			wed_cleanup
		fi
	fi
	if [ "$CLEANUP_CPU_COMMITTING" != 0 ] && [ -n "$CLEANUP_CPU_TXN" ]; then
		cpu_phase=$CLEANUP_CPU_COMMITTING
		CLEANUP_CPU_COMMITTING=0
		if [ "$cpu_phase" = 2 ] &&
			uci_ro_read mtk_wed cpu.governor && [ "$UCI_VAL" = "$CLEANUP_CPU_GOV" ] &&
			uci_ro_read mtk_wed cpu.max_freq && [ "$UCI_VAL" = "$CLEANUP_CPU_FREQ" ]; then
			:
		else
			cpu_restore "$CLEANUP_CPU_TXN" "$CLEANUP_CPU_APPLIED"
		fi
		CLEANUP_CPU_TXN=
		CLEANUP_CPU_APPLIED=
		CLEANUP_CPU_GOV=
		CLEANUP_CPU_FREQ=
	fi
	if [ -n "$CLEANUP_PATHS" ]; then
		while IFS= read -r p; do
			[ -n "$p" ] && rm -rf "$p" 2>/dev/null
		done <<EOF
$CLEANUP_PATHS
EOF
		CLEANUP_PATHS=
	fi
}

cleanup_on_signal() {
	local sig="$1"
	cleanup_on_exit
	trap - "$sig"
	kill -"$sig" $$ 2>/dev/null || exit 128
}

trap 'cleanup_on_exit' EXIT
trap 'cleanup_on_signal INT' INT
trap 'cleanup_on_signal TERM' TERM
trap 'cleanup_on_signal HUP' HUP

# jesc(s): s escaped for a JSON string. It is built by concatenation only:
# BusyBox awk versions differ in how gsub() reads backslashes in a
# replacement, and 1.37/1.38 neither double them nor escape quotes.
JESC_AWK='
function jesc(s,   i, n, c, out) {
	if (!JE_INIT) {
		JE_INIT = 1
		for (i = 1; i < 32; i++) JE[sprintf("%c", i)] = sprintf("\\u%04x", i)
		JE["\t"] = "\\t"; JE["\n"] = "\\n"; JE["\r"] = "\\r"
		JE["\\"] = "\\\\"; JE["\""] = "\\\""
	}
	out = ""; n = length(s)
	for (i = 1; i <= n; i++) { c = substr(s, i, 1); out = out ((c in JE) ? JE[c] : c) }
	return out
}
'

json_str() {
	# Escape a value for use inside a JSON string; lines join as \n.
	printf '%s' "$1" | awk "$JESC_AWK"'{ printf "%s%s", (NR > 1 ? "\\n" : ""), jesc($0) }'
}

# The page polls every five seconds, so the hot paths avoid subshells and
# helper processes: rd, ri and js return in variables and use builtins only.

# rd <file>: first line of a file in $RD, empty when it cannot be read.
rd() {
	RD=
	[ -r "$1" ] && IFS= read -r RD 2>/dev/null < "$1"
	return 0
}

# ri <file> <fallback>: the file's RFC 8259 integer value in $RI, else the fallback.
ri() {
	rd "$1"
	case "$RD" in
		0) RI=0 ;;
		[1-9]*)
			case "${RD#?}" in
				*[!0-9]*) RI=$2 ;;
				*) RI=$RD ;;
			esac ;;
		-[1-9]*)
			case "${RD#??}" in
				*[!0-9]*) RI=$2 ;;
				*) RI=$RD ;;
			esac ;;
		*) RI=$2 ;;
	esac
}

# js <value>: the value escaped for a JSON string in $JS; plain values skip
# the awk process.
js() {
	case "$1" in
		*[\"\\]*|*[![:print:]]*) JS=$(json_str "$1") ;;
		*) JS=$1 ;;
	esac
}

read_first() {
	rd "$1"
	printf '%s' "$RD"
}

int_or() {
	# int_or <value> <fallback>
	case "$1" in
		0) printf '0' ;;
		[1-9]*)
			case "${1#?}" in
				*[!0-9]*) printf '%s' "$2" ;;
				*) printf '%s' "$1" ;;
			esac ;;
		-[1-9]*)
			case "${1#??}" in
				*[!0-9]*) printf '%s' "$2" ;;
				*) printf '%s' "$1" ;;
			esac ;;
		*) printf '%s' "$2" ;;
	esac
}

# Module arguments split and decoded like the kernel's next_arg(): spaces
# inside double quotes do not split, quotes around a value are dropped, a
# name matches with "-" or "_" and an argument without "=" means "1".
# kargs(s, out) fills out[1..n] with the raw arguments; karg(a) sets KN and KV.
KARGS_AWK='
function kargs(s, out,   n, i, len, c, q, st) {
	n = 0; len = length(s); i = 1
	while (i <= len) {
		while (i <= len && substr(s, i, 1) ~ /[[:space:]]/) i++
		if (i > len) break
		st = i; q = 0
		if (substr(s, i, 1) == "\"") { q = 1; i++ }
		for (; i <= len; i++) {
			c = substr(s, i, 1)
			if (c ~ /[[:space:]]/ && !q) break
			if (c == "\"") q = !q
		}
		out[++n] = substr(s, st, i - st)
	}
	return n
}
function unq(v) {
	if (substr(v, 1, 1) == "\"") { v = substr(v, 2); if (substr(v, length(v)) == "\"") v = substr(v, 1, length(v) - 1) }
	return v
}
function karg(a,   e) {
	a = unq(a); KSTOP = (a == "--"); e = index(a, "=")
	if (e) { KN = substr(a, 1, e - 1); KV = unq(substr(a, e + 1)) } else { KN = a; KV = "1" }
	gsub(/-/, "_", KN)
}
'

# kbool <value>: kstrtobool() as the kernel applies it to a bool module
# parameter, into $KB as true, false or null.
kbool() {
	case "$1" in
		[eEyYtT1]*|[oO][nN]*) KB=true ;;
		[dDnNfF0]*|[oO][fF]*) KB=false ;;
		*) KB=null ;;
	esac
}

json_input() {
	# json_input <json> <key>
	printf '%s' "$1" | jsonfilter -e "@.$2" 2>/dev/null
}

# Read a committed UCI option into $UCI_VAL without ever seeing /tmp/.uci:
# OpenWrt libuci keeps /tmp/.uci in ctx->delta_path even when -t <savedir> is
# passed, so we read a copy under a unique temp package name that cannot exist
# in /tmp/.uci. Runs in the main shell so EXIT/TERM traps track $tmp cleanly.
uci_ro_read() {
	local pkg="$1" opt="$2" src="$R/etc/config/$1" tmp sfx tpkg rc=1
	UCI_VAL=
	[ -r "$src" ] || return 1
	[ -d "$STATE" ] || mkdir -p -m 0700 "$STATE" 2>/dev/null
	tmp=$(mktemp -d "$STATE/uci-ro.XXXXXX" 2>/dev/null || mktemp -d "/tmp/mtkw-uci-ro.XXXXXX" 2>/dev/null) || return 1
	cleanup_add "$tmp"
	sfx=${tmp##*.}
	case "$sfx" in ''|*[!A-Za-z0-9_]*) sfx=$$ ;; esac
	tpkg="mtkw_$sfx"
	if mkdir -p "$tmp/cfg" "$tmp/save" 2>/dev/null && cp "$src" "$tmp/cfg/$tpkg" 2>/dev/null; then
		if UCI_VAL=$(uci -c "$tmp/cfg" -t "$tmp/save" -q get "$tpkg.$opt"); then
			rc=0
		fi
	fi
	rm -rf "$tmp"
	cleanup_del "$tmp"
	return $rc
}

uci_ro_get() {
	uci_ro_read "$1" "$2" || return 1
	printf '%s\n' "$UCI_VAL"
}

# Read both committed firewall flow-offload options from a single isolated temp
# copy (sets UCI_FO, UCI_HAD_FO, UCI_FOH, UCI_HAD_FOH).
uci_ro_flow() {
	local src="$FW_CONF" tmp sfx tpkg rc=1
	UCI_FO=; UCI_HAD_FO=0; UCI_FOH=; UCI_HAD_FOH=0
	[ -r "$src" ] || return 1
	[ -d "$STATE" ] || mkdir -p -m 0700 "$STATE" 2>/dev/null
	tmp=$(mktemp -d "$STATE/uci-ro.XXXXXX" 2>/dev/null || mktemp -d "/tmp/mtkw-uci-ro.XXXXXX" 2>/dev/null) || return 1
	cleanup_add "$tmp"
	sfx=${tmp##*.}
	case "$sfx" in ''|*[!A-Za-z0-9_]*) sfx=$$ ;; esac
	tpkg="mtkw_$sfx"
	if mkdir -p "$tmp/cfg" "$tmp/save" 2>/dev/null && cp "$src" "$tmp/cfg/$tpkg" 2>/dev/null &&
		[ "$(uci -c "$tmp/cfg" -t "$tmp/save" -q get "$tpkg.@defaults[0]" 4>&- 7<&-)" = defaults ]; then
		rc=0
		if UCI_FO=$(uci -c "$tmp/cfg" -t "$tmp/save" -q get "$tpkg.@defaults[0].flow_offloading" 4>&- 7<&-); then
			UCI_HAD_FO=1
		fi
		if UCI_FOH=$(uci -c "$tmp/cfg" -t "$tmp/save" -q get "$tpkg.@defaults[0].flow_offloading_hw" 4>&- 7<&-); then
			UCI_HAD_FOH=1
		fi
	fi
	rm -rf "$tmp"
	cleanup_del "$tmp"
	return "$rc"
}

# flock_wait <x|s> <fd> <max_sec>: bounded non-blocking flock retry.
flock_wait() {
	local mode="$1" fd="$2" max="$3" i=0 rc
	while :; do
		if [ "$mode" = s ]; then flock -s -n "$fd"; else flock -n "$fd"; fi
		rc=$?
		[ "$rc" = 0 ] && return 0
		[ "$rc" = 1 ] || return 2
		[ "$i" -lt "$max" ] || return 1
		i=$((i + 1))
		sleep 1
	done
}

# Resolve $1 through readlink -f when it is a symlink, into $UCI_TARGET.
uci_resolve_target() {
	if [ -L "$1" ]; then
		UCI_TARGET=$(readlink -f "$1" 2>/dev/null) || return 1
	else
		UCI_TARGET=$1
	fi
}

# Atomically apply UCI mutations to $R/etc/config/<pkg> under a unique temp
# package name inside a private -c/-t dir so libuci's fixed /tmp/.uci
# delta_path can never read, commit, or alter unrelated staged changes.
# Uses target-file flock + optimistic compute + locked CAS verify-and-swap so
# concurrent UCI commits or in-place edits are cleanly merged and never lost.
# Usage: uci_pkg_apply <pkg> <op>... where op is set:<opt=val>, del:<opt>, keep
uci_pkg_apply() {
	local pkg="$1" conf target cur_target target_dir target_base tmp sfx tpkg stage op rest
	local try=0 max_tries="$UCI_CAS_TRIES" had_target snap_ok lrc uci_rc rc=1
	local cur_fo cur_had_fo cur_foh cur_had_foh
	shift
	[ -d "$STATE" ] || mkdir -p -m 0700 "$STATE" 2>/dev/null
	{
		flock_wait x 5 "$UCI_LOCK_WAIT" || return 1
		tmp=$(mktemp -d "$STATE/uci.XXXXXX" 2>/dev/null) || return 1
		cleanup_add "$tmp"
		sfx=${tmp##*.}
		case "$sfx" in ''|*[!A-Za-z0-9_]*) sfx=$$ ;; esac
		tpkg="mtkw_$sfx"
		conf="$R/etc/config/$pkg"
		while [ "$try" -lt "$max_tries" ]; do
			try=$((try + 1))
			rc=1
			rm -rf "$tmp/cfg" "$tmp/save" "$tmp/orig" 2>/dev/null
			mkdir -p "$tmp/cfg" "$tmp/save" 2>/dev/null || break

			# 1. Resolve target (following symlinks) and verify regular/absent.
			uci_resolve_target "$conf" || break
			target=$UCI_TARGET
			[ ! -e "$target" ] || [ -f "$target" ] || break
			target_dir=${target%/*}
			target_base=${target##*/}

			# 2. Snapshot $target under brief shared flock (or create empty if absent).
			had_target=0
			snap_ok=0
			if [ -f "$target" ]; then
				had_target=1
				if { command exec 6< "$target"; } 2>/dev/null; then
					flock_wait s 6 "$UCI_LOCK_WAIT"
					lrc=$?
					if [ "$lrc" = 0 ]; then
						if [ ! -e /proc/self/fd/6 ] || [ /proc/self/fd/6 -ef "$target" ]; then
							if cp -p "$target" "$tmp/orig" 2>/dev/null && cp -p "$tmp/orig" "$tmp/cfg/$tpkg" 2>/dev/null; then
								snap_ok=1
							else
								exec 6<&-
								[ -e "$target" ] && break
								continue
							fi
						fi
						exec 6<&-
						[ "$snap_ok" = 1 ] || continue
					else
						exec 6<&-
						break
					fi
				else
					# Vanished between [ -f ] and open -> retry against current state.
					continue
				fi
			elif [ ! -e "$target" ]; then
				: > "$tmp/orig" && chmod 0644 "$tmp/orig" 2>/dev/null &&
					cp -p "$tmp/orig" "$tmp/cfg/$tpkg" 2>/dev/null || break
			else
				break
			fi

			# 3. Optional atomic pre-change flow_offload snapshot or conflict check inside the winning attempt.
			if [ "${UCI_SNAP_FLOW:-0}" = 1 ]; then
				UCI_FO=; UCI_HAD_FO=0; UCI_FOH=; UCI_HAD_FOH=0
				if UCI_FO=$(uci -c "$tmp/cfg" -t "$tmp/save" -q get "$tpkg.@defaults[0].flow_offloading"); then
					UCI_HAD_FO=1
				fi
				if UCI_FOH=$(uci -c "$tmp/cfg" -t "$tmp/save" -q get "$tpkg.@defaults[0].flow_offloading_hw"); then
					UCI_HAD_FOH=1
				fi
			fi
			if [ "${UCI_EXPECT_FLOW:-0}" = 1 ]; then
				cur_fo=; cur_had_fo=0; cur_foh=; cur_had_foh=0
				if cur_fo=$(uci -c "$tmp/cfg" -t "$tmp/save" -q get "$tpkg.@defaults[0].flow_offloading"); then
					cur_had_fo=1
				fi
				if cur_foh=$(uci -c "$tmp/cfg" -t "$tmp/save" -q get "$tpkg.@defaults[0].flow_offloading_hw"); then
					cur_had_foh=1
				fi
				if { [ "${UCI_EXP_CHK_FO:-0}" = 1 ] && { [ "$cur_had_fo" != 1 ] || [ "$cur_fo" != "$UCI_EXP_FO" ]; }; } ||
					[ "$cur_had_foh" != 1 ] || [ "$cur_foh" != "$UCI_EXP_FOH" ]; then
					rc=2
					break
				fi
			fi

			# 4. Apply UCI ops and commit inside private $tmp (NO LOCK_EX on $target).
			uci_rc=0
			for op in "$@"; do
				case "$op" in
					set:*) rest=${op#set:}; uci -c "$tmp/cfg" -t "$tmp/save" -q set "$tpkg.$rest" || { uci_rc=1; break; } ;;
					del:*) rest=${op#del:}; uci -c "$tmp/cfg" -t "$tmp/save" -q delete "$tpkg.$rest" || { uci_rc=1; break; } ;;
					keep) ;;
					*) uci_rc=1; break ;;
				esac
			done
			[ "$uci_rc" = 0 ] && uci -c "$tmp/cfg" -t "$tmp/save" -q commit "$tpkg" || uci_rc=1
			[ "$uci_rc" = 0 ] || break

			# 5. No-op optimization: skip disk write when committed content is unchanged.
			if [ "$had_target" = 1 ] && cmp -s "$tmp/orig" "$tmp/cfg/$tpkg" 2>/dev/null; then
				if [ -f "$target" ] && cmp -s "$tmp/orig" "$target" 2>/dev/null; then
					rc=0
					break
				fi
				continue
			fi

			# 6. Stage into same directory as $target (still NO LOCK_EX on $target).
			mkdir -p "$target_dir" 2>/dev/null || break
			stage=$(mktemp "$target_dir/.$target_base.mtkw.XXXXXX" 2>/dev/null) || break
			cleanup_add "$stage"
			if [ "$had_target" = 1 ]; then
				cp -p "$tmp/orig" "$stage" 2>/dev/null && cat "$tmp/cfg/$tpkg" 2>/dev/null > "$stage"
			else
				chmod 0644 "$stage" 2>/dev/null && cat "$tmp/cfg/$tpkg" 2>/dev/null > "$stage"
			fi || { rm -f "$stage"; cleanup_del "$stage"; break; }

			# 7. Sub-millisecond locked verify-and-swap.
			uci_resolve_target "$conf" || { rm -f "$stage"; cleanup_del "$stage"; break; }
			cur_target=$UCI_TARGET
			if [ "$cur_target" != "$target" ]; then
				rm -f "$stage"; cleanup_del "$stage"
				continue
			fi

			if [ "$had_target" = 1 ]; then
				if ! { command exec 6< "$target"; } 2>/dev/null; then
					rm -f "$stage"; cleanup_del "$stage"
					continue
				fi
				flock_wait x 6 "$UCI_LOCK_WAIT"
				lrc=$?
				if [ "$lrc" != 0 ]; then
					exec 6<&-
					rm -f "$stage"; cleanup_del "$stage"
					break
				fi
				if { [ ! -e /proc/self/fd/6 ] || [ /proc/self/fd/6 -ef "$target" ]; } &&
					cmp -s "$tmp/orig" "$target" 2>/dev/null; then
					if mv -f "$stage" "$target" 2>/dev/null; then
						cleanup_del "$stage"
						exec 6<&-
						rc=0
						break
					fi
					exec 6<&-
					rm -f "$stage"; cleanup_del "$stage"
					break
				fi
				# Concurrent modification (inode swap or in-place write): retry.
				exec 6<&-
				rm -f "$stage"; cleanup_del "$stage"
				continue
			else
				# Create absent file atomically via POSIX link(2) (EEXIST if raced).
				if ln "$stage" "$target" 2>/dev/null; then
					rm -f "$stage"; cleanup_del "$stage"
					rc=0
					break
				fi
				if [ -e "$target" ]; then
					rm -f "$stage"; cleanup_del "$stage"
					continue
				fi
				# Fallback for filesystems without hardlink support while still absent.
				if [ ! -e "$target" ] && mv -f "$stage" "$target" 2>/dev/null; then
					cleanup_del "$stage"
					rc=0
					break
				fi
				rm -f "$stage"; cleanup_del "$stage"
				break
			fi
		done
		rm -rf "$tmp"
		cleanup_del "$tmp"
		return $rc
	} 5> "$STATE/uci.lock"
}

# ── Board / CPU ─────────────────────────────────────────────────────────

board_compatible() {
	tr '\0' ' ' 2>/dev/null < "$R/proc/device-tree/compatible" | awk '{print $1}'
}

# The last compatible string names the SoC, e.g. "mediatek,mt7988a".
soc_compatible() {
	tr '\0' ' ' 2>/dev/null < "$R/proc/device-tree/compatible" | awk '{print $NF}'
}

cpu_policy() {
	local p
	for p in "$R"/sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$p" ] && { printf '%s' "$p"; return; }
	done
}

# CPU temperature in millidegrees into $RI (0 when unknown).
cpu_temp_milli() {
	local z
	for z in "$R"/sys/class/thermal/thermal_zone*; do
		rd "$z/type"
		case "$RD" in cpu-thermal|cpu_thermal|soc-thermal|soc_thermal)
			ri "$z/temp" 0; return ;;
		esac
	done
	ri "$R/sys/class/thermal/thermal_zone0/temp" 0
}

cpu_json() {
	local p gov govs freqs cur min max hwmax count arch temp cores=
	p=$(cpu_policy)
	count=$(grep -c '^processor' "$R/proc/cpuinfo" 2>/dev/null)
	arch=$(awk -F': *' '/^CPU part/{print $2; exit}' "$R/proc/cpuinfo" 2>/dev/null)
	case "$arch" in
		0xd09) arch='Cortex-A73' ;; 0xd08) arch='Cortex-A72' ;;
		0xd03) arch='Cortex-A53' ;; 0xd05) arch='Cortex-A55' ;;
	esac
	cpu_temp_milli; temp=$RI
	if [ -n "$p" ]; then
		rd "$p/scaling_governor"; gov=$RD
		rd "$p/scaling_available_governors"; govs=$RD
		rd "$p/scaling_available_frequencies"; freqs=$RD
		ri "$p/scaling_cur_freq" 0; cur=$RI
		[ "$cur" -gt 0 ] || { ri "$p/cpuinfo_cur_freq" 0; cur=$RI; }
		ri "$p/cpuinfo_min_freq" 0; min=$RI
		ri "$p/cpuinfo_max_freq" 0; hwmax=$RI
		ri "$p/scaling_max_freq" 0; max=$RI
	fi
	if [ -r "$R/proc/stat" ]; then
		# Cumulative per-core jiffies; %.0f avoids 32-bit int overflow in BusyBox awk.
		# $7 is hard irq and $8 is pure softirq; keep them separate.
		cores=$(awk '/^cpu[0-9]+[[:space:]]/ && NF >= 5 {
			printf "%s{\"id\":%d,\"total\":%.0f,\"idle\":%.0f,\"sirq\":%.0f,\"irq\":%.0f}",
				(n++ ? "," : ""), substr($1, 4) + 0,
				$2 + $3 + $4 + $5 + $6 + $7 + $8 + $9, $5 + $6, $8 + 0, $7 + 0
		}' "$R/proc/stat" 2>/dev/null) || cores=
	fi
	case "$count" in ''|*[!0-9]*) count=0 ;; esac
	js "$arch"; arch=$JS
	js "$gov"; gov=$JS
	js "$govs"; govs=$JS
	js "$freqs"; freqs=$JS
	printf '"cpu":{"count":%s,"arch":"%s","temp_milli":%s,"cpufreq":%s,"governor":"%s","governors":"%s","frequencies":"%s","cur_freq":%s,"min_freq":%s,"hw_max_freq":%s,"max_freq":%s,"cores":[%s]}' \
		"$count" "$arch" "$temp" "$([ -n "$p" ] && echo true || echo false)" \
		"$gov" "$govs" "$freqs" "${cur:-0}" "${min:-0}" "${hwmax:-0}" "${max:-0}" "$cores"
}

# Monotonic seconds: no date process and no wall-clock/NTP jumps.
clock_now() {
	local rest
	NOW=
	[ -r "$R/proc/uptime" ] && read -r NOW rest < "$R/proc/uptime"
	NOW=${NOW%%.*}
	case "$NOW" in ''|*[!0-9]*) NOW=; return 1 ;; esac
}

# ppe_fresh <sources> <ttl>: the snapshot covers these tables and is younger
# than ttl seconds at $NOW.
ppe_fresh() {
	local stamp generation saved
	[ -f "$PPE_SNAPSHOT" ] || return 1
	{ read -r stamp generation; IFS= read -r saved; } < "$PPE_SNAPSHOT"
	case "$stamp" in ''|*[!0-9]*) return 1 ;; esac
	[ "$saved" = "$1" ] && [ "$NOW" -ge "$stamp" ] && [ $((NOW - stamp)) -lt "$2" ]
}

# Cache raw PPE data, not a truncated result. One atomically replaced file
# keeps every engine in the same generation; readers pin its inode on fd 3.
# One caller collects at a time; the others wait and take its snapshot, so
# concurrent requests cannot multiply the copies held in RAM.
ppe_snapshot() {
	local sources="$1" ttl="$2" got=0
	PPE_SNAPSHOT="$STATE/ppe.snapshot"
	[ -d "$STATE" ] || mkdir -p -m 0700 "$STATE" 2>/dev/null
	if ! clock_now; then
		[ "$ttl" = 0 ] && NOW=0 || return 1
	fi
	[ "$ttl" -gt 0 ] && ppe_fresh "$sources" "$ttl" && return 0
	# Read the clock again once the lock is held: a caller that waited
	# judges, and stamps, by the time it actually samples.
	{
		flock_wait x 4 "$PPE_LOCK_WAIT" && got=1
		if [ "$got" = 1 ]; then
			if ! clock_now; then
				[ "$ttl" = 0 ] && NOW=0 || return 1
			fi
			if [ "$ttl" = 0 ] || ! ppe_fresh "$sources" "$ttl"; then
				rm -f "$PPE_SNAPSHOT".* 2>/dev/null
				ppe_collect "$sources" || return 1
			fi
			return 0
		fi
		# Lock timed out: fall back to an existing readable snapshot if present.
		if [ -r "$PPE_SNAPSHOT" ]; then
			clock_now || NOW=0
			return 0
		fi
		return 1
	} 4> "$STATE/ppe.lock"
}

ppe_collect() {
	local tmp f id
	tmp=$(mktemp "$PPE_SNAPSHOT.XXXXXX" 2>/dev/null) || return 1
	cleanup_add "$tmp"
	printf '%s %s\n%s\n' "$NOW" "${tmp##*/}" "$1" > "$tmp" || { rm -f "$tmp"; cleanup_del "$tmp"; return 1; }
	for f in $1; do
		id=${f%/entries}; id=${id##*/ppe}
		printf '#PPE %s\n' "$id" >> "$tmp" || { rm -f "$tmp"; cleanup_del "$tmp"; return 1; }
		if ! cat "$f" >> "$tmp"; then rm -f "$tmp"; cleanup_del "$tmp"; return 1; fi
	done
	mv -f "$tmp" "$PPE_SNAPSHOT" && cleanup_del "$tmp" || { rm -f "$tmp"; cleanup_del "$tmp"; return 1; }
}

ppe_reply() {
	if [ "$2" = 1 ]; then
		printf '%s,"sample_age":%s}' "${1%\}}" "$3"
	else
		printf '%s' "$1"
	fi
}

# ── PPE ─────────────────────────────────────────────────────────────────

# One JSON object per PPE: entry counts by state and by type. Routed through
# ppe_snapshot so unskipped getStatus calls serialize on ppe.lock.
ppe_json() {
	local d id files="" out=""
	for d in "$DBG"/ppe[0-9]*; do
		[ -r "$d/entries" ] || continue
		id=${d##*/ppe}
		case "$id" in ''|*[!0-9]*) continue ;; esac
		files="$files $d/entries"
	done
	if [ -z "$files" ]; then
		printf '"ppe":[]'
		return
	fi
	if ppe_snapshot "$files" 0 && { command exec 3< "$PPE_SNAPSHOT"; } 2>/dev/null; then
		out=$(awk '
			function finish() {
				if (!active) return
				printf "%s{\"id\":%d,\"total\":%d,\"bound\":%d,\"unbound\":%d,\"fin\":%d,\"ipv4\":%d,\"ipv6\":%d}",
					(n++ ? "," : ""), ppe, total, s["BND"], s["UNB"], s["FIN"],
					ty["IPv4 5T"]+ty["IPv4 3T"]+ty["DS-LITE"],
					ty["IPv6 5T"]+ty["IPv6 3T"]+ty["6RD"]
			}
			FNR <= 2 { next }
			$1 == "#PPE" { finish(); ppe = $2; active = 1; total = 0; delete s; delete ty; next }
			{ total++; s[$2]++; t = $3; if ($4 != "" && $4 !~ /=/) t = t " " $4; ty[t]++ }
			END { finish() }' /proc/self/fd/3 2>/dev/null)
		exec 3<&-
	fi
	printf '"ppe":[%s]' "$out"
}

# Count every FOE entry once; serialize only the requested page. Calls without
# a page retain the original PPE_MAX_ENTRIES cap for existing clients.
# Line format (mtk_ppe_debugfs.c):
#   %05x <state> <type 1-2 words> orig=<a>-><b> [new=<a>-><b>] eth=<m>-><m>
#   etype=%04x vlan=%d,%d ib1=%08x ib2=%08x packets=%llu bytes=%llu
get_ppe_entries() {
	local d id page= state= type_filter= ppe_filter= result args files=""
	local snapshot=0 ttl=20 refresh= interval= stamp generation saved key cached_key cached_json tmp age=0
	local page_kind= state_kind= type_kind= ppe_kind= refresh_kind= interval_kind=
	local query_cache="$STATE/ppe.query" meta_prefix= meta_suffix=
	# jsonfilter quotes exported strings for shell evaluation. Names and
	# expressions are fixed here; user input is only parsed as JSON data.
	args=$(jsonfilter -s "$1" -e 'page=@.page' -e 'state=@.state' \
		-e 'type_filter=@.type' -e 'ppe_filter=@.ppe' -e 'refresh=@.refresh' -e 'interval=@.interval' \
		-t 'page_kind=@.page' -t 'state_kind=@.state' -t 'type_kind=@.type' \
		-t 'ppe_kind=@.ppe' -t 'refresh_kind=@.refresh' -t 'interval_kind=@.interval' 2>/dev/null)
	eval "$args"
	case "$page_kind" in ''|null|string|int) ;; *) printf '{"error":"invalid page"}'; return ;; esac
	case "$state_kind" in ''|null|string) ;; *) printf '{"error":"invalid state"}'; return ;; esac
	case "$type_kind" in ''|null|string) ;; *) printf '{"error":"invalid type"}'; return ;; esac
	case "$ppe_kind" in ''|null|string|int) ;; *) printf '{"error":"invalid ppe"}'; return ;; esac
	case "$interval_kind" in ''|null|int) ;; *) printf '{"error":"invalid interval"}'; return ;; esac
	case "$interval" in *[!0-9]*|?????*) printf '{"error":"invalid interval"}'; return ;; esac
	# No page keeps the original capped response for existing RPC clients.
	case "$page" in
		'') page=-1 ;;
		*[!0-9]*|???????*) printf '{"error":"invalid page"}'; return ;;
	esac
	case "$state" in ''|BND|UNB|FIN) ;; *) printf '{"error":"invalid state"}'; return ;; esac
	case "$type_filter" in ''|IPv4|IPv6|DS-LITE|6RD) ;; *) printf '{"error":"invalid type"}'; return ;; esac
	case "$ppe_filter" in *[!0-9]*|???????*) printf '{"error":"invalid ppe"}'; return ;; esac
	for d in "$DBG"/ppe[0-9]*; do
		[ -r "$d/entries" ] || continue
		id=${d##*/ppe}
		case "$id" in ''|*[!0-9]*) continue ;; esac
		files="$files $d/entries"
	done
	if [ -z "$files" ]; then
		printf '{"available":false,"entries":[],"total":0,"matched":0,"ppe":[]}'
		return
	fi
	if [ "$page" -ge 0 ]; then
		# Live polls come from each open page every "interval" seconds (20
		# when not given; at least 5, as a full table takes a while to copy).
		# A snapshot two seconds younger is shared between pages, while one
		# page, even with a second of timer or request jitter, still reads
		# fresh tables; it is never older than the 20 s that clicks accept.
		case "$refresh_kind:$refresh" in
			boolean:1|string:true)
				[ "${interval:-0}" -gt 0 ] || interval=20
				[ "$interval" -ge 5 ] || interval=5
				[ "$interval" -le 20 ] || interval=20
				ttl=$((interval - 2))
				;;
		esac
	else
		ttl=0
	fi
	if ! ppe_snapshot "$files" "$ttl"; then
		printf '{"available":false,"entries":[],"ppe":[],"error":"cannot snapshot PPE tables"}'
		return
	fi
	{ command exec 3< "$PPE_SNAPSHOT"; } 2>/dev/null || {
		printf '{"available":false,"entries":[],"ppe":[],"error":"cannot read the PPE snapshot"}'
		return
	}
	if [ "$page" -ge 0 ]; then
		read -r stamp generation <&3
		IFS= read -r saved <&3
		age=$((NOW - stamp)); [ "$age" -ge 0 ] || age=0
		key="$generation:$page:$state:$type_filter:$ppe_filter"
		if [ -r "$query_cache" ]; then
			{ IFS= read -r cached_key; IFS= read -r cached_json; } < "$query_cache"
			if [ "$cached_key" = "$key" ]; then
				case "$cached_json" in
					\{*\}) exec 3<&-; ppe_reply "$cached_json" 1 "$age"; return ;;
				esac
			fi
			case "$cached_key" in
				"$generation":*)
					# The summary is independent of filter/page. Its numeric-only
					# prefix and PPE suffix can be reused without parsing JSON.
					meta_prefix=${cached_json%%,\"truncated\":*}
					meta_suffix=${cached_json##*,\"ppe\":}
					[ "$meta_prefix" != "$cached_json" ] && [ "$meta_suffix" != "$cached_json" ] || { meta_prefix=; meta_suffix=; }
					;;
			esac
		fi
	fi
	files=/proc/self/fd/3
	snapshot=1
	# shellcheck disable=SC2086
	if result=$(awk -v max="$PPE_MAX_ENTRIES" -v page="$page" -v state="$state" \
		-v type_filter="$type_filter" -v ppe_filter="$ppe_filter" -v snapshot="$snapshot" \
		-v meta_prefix="$meta_prefix" -v meta_suffix="$meta_suffix" "$JESC_AWK"'
		BEGIN {
			have_meta = meta_prefix != "" && meta_suffix != ""
			unfiltered = have_meta && state == "" && type_filter == "" && ppe_filter == ""
			if (unfiltered) {
				matched = meta_prefix; sub(/^.*"total":/, "", matched); sub(/,.*/, "", matched); matched += 0
			}
			if (page >= 0) max = 50
			for (i = 1; !snapshot && i < ARGC; i++) {
				id = ARGV[i]; sub(/\/entries$/, "", id); sub(/.*\/ppe/, "", id)
				ids[++idcount] = id
			}
		}
		function esc(s) { return (index(s, "\\") || index(s, "\"") || s ~ /[[:cntrl:]]/) ? jesc(s) : s }
		function field(k) { return values[k] }
		function num(s) { return (s ~ /^[0-9]+$/) ? sprintf("%.0f", s + 0) : "null" }
		function decode_fields(   i, eq, key) {
			delete values
			for (i = 1; i <= NF; i++) {
				eq = index($i, "="); if (!eq) continue
				key = substr($i, 1, eq - 1)
				if (!(key in values)) values[key] = substr($i, eq + 1)
			}
		}
		function finish_engine() {
			if (!active || have_meta) return
			pt[ppe] = etotal; pb[ppe] = ebound; pu[ppe] = eunbound
			pf[ppe] = efin; pv4[ppe] = ev4; pv6[ppe] = ev6
		}
		function start_engine(id) {
			finish_engine()
			ppe = id; active = 1
			etotal = ebound = eunbound = efin = ev4 = ev6 = 0
		}
		snapshot && FNR <= 2 { next }
		snapshot && $1 == "#PPE" { start_engine($2); ids[++idcount] = ppe; next }
		!snapshot && FNR == 1 { engine = FILENAME; sub(/\/entries$/, "", engine); sub(/.*\/ppe/, "", engine); start_engine(engine) }
		{
			if (unfiltered) {
				if (n >= max) exit
				if (++seen <= page * max) next
			}
			if (!have_meta) {
				etotal++
				if ($2 == "BND") ebound++; else if ($2 == "UNB") eunbound++; else if ($2 == "FIN") efin++
				if ($3 ~ /^IPv4|^DS-LITE/) ev4++; else if ($3 ~ /^IPv6|^6RD/) ev6++
			}
			if (!unfiltered) {
				if ((state != "" && $2 != state) ||
				    (type_filter != "" && index($3, type_filter) != 1) ||
				    (ppe_filter != "" && ppe + 0 != ppe_filter + 0)) next
				matched++
				if (n >= max || (page >= 0 && matched <= page * max)) next
			}
			type = $3; if ($4 != "" && $4 !~ /=/) type = type " " $4
			decode_fields()
			vlan = field("vlan"); split(vlan, vl, ",")
			v = (vl[1] + 0) ? vl[1] : "-"
			if ((vl[2] + 0)) v = v "," vl[2]
			pk = field("packets"); by = field("bytes")
			row = sprintf("{\"ppe\":%d,\"index\":\"%s\",\"state\":\"%s\",\"type\":\"%s\",\"orig\":\"%s\",\"new\":\"%s\",\"eth\":\"%s\",\"vlan\":\"%s\",\"packets\":%s,\"bytes\":%s}",
				ppe, esc($1), esc($2), esc(type), esc(field("orig")), esc(field("new")), esc(field("eth")),
				esc(v), num(pk), num(by))
			out = out (n ? "," : "") row
			n++
		}
		END {
			finish_engine()
			if (have_meta) {
				printf "%s,\"truncated\":false,\"matched\":%d,\"page\":%d,\"entries\":[%s],\"ppe\":%s", meta_prefix, matched, page, out, meta_suffix
				exit
			}
			# Derive global counts once, instead of updating them for every row.
			for (i = 1; i <= idcount; i++) {
				id = ids[i]; total += pt[id]; bound += pb[id]; unbound += pu[id]
				v4 += pv4[id]; v6 += pv6[id]
			}
			printf "{\"available\":true,\"total\":%d,\"bound\":%d,\"unbound\":%d,\"ipv4\":%d,\"ipv6\":%d,\"truncated\":%s,\"matched\":%d,\"page\":%d,\"entries\":[%s],\"ppe\":[",
				total, bound, unbound, v4, v6, (page < 0 && matched > n ? "true" : "false"), matched, page, out
			for (i = 1; i <= idcount; i++) {
				id = ids[i]
				printf "%s{\"id\":%d,\"total\":%d,\"bound\":%d,\"unbound\":%d,\"fin\":%d,\"ipv4\":%d,\"ipv6\":%d}",
					(i > 1 ? "," : ""), id, pt[id], pb[id], pu[id], pf[id], pv4[id], pv6[id]
			}
			printf "]}"
		}' $files 2>/dev/null); then
		exec 3<&-
		if [ "$page" -ge 0 ]; then
			tmp=$(mktemp "$query_cache.XXXXXX" 2>/dev/null) || tmp=
			if [ -n "$tmp" ]; then
				cleanup_add "$tmp"
				printf '%s\n%s\n' "$key" "$result" > "$tmp" &&
					mv -f "$tmp" "$query_cache" && cleanup_del "$tmp" || { rm -f "$tmp"; cleanup_del "$tmp"; }
			fi
			ppe_reply "$result" 1 "$age"
		else
			ppe_reply "$result" 0 0
		fi
	else
		exec 3<&-
		printf '{"available":false,"entries":[],"ppe":[],"error":"cannot read PPE tables"}'
	fi
}

# ── WED ─────────────────────────────────────────────────────────────────

WO_CACHE="$STATE/wo-firmware"

# The WO firmware is logged only when a WED attaches, right after that WED's
# "attaching wed device N" line: mtk_wed_attach() holds hw_lock across both,
# so the lines of two WEDs never interleave. What was seen is kept, since
# the kernel log ring buffer drops it on a long-running router.
# Prints "<version>|<build>" of the last one logged, then "<wed>|<version>|<build>"
# for each WED it was logged for.
wo_firmware() {
	local top= stamp= l recs= seen= out tmp
	clock_now
	if [ -r "$WO_CACHE" ]; then
		{
			IFS= read -r top; read -r stamp
			while IFS= read -r l; do recs="$recs$l$NL"; seen="$seen@$l$NL"; done
		} < "$WO_CACHE"
		case "$stamp" in
			''|*[!0-9]*) ;;
			*) if [ -n "$NOW" ] && [ "$NOW" -ge "$stamp" ] && [ $((NOW - stamp)) -lt 60 ]; then
				printf '%s\n%s' "$top" "$recs"; return
			fi ;;
		esac
	fi
	# The cached lines come first (line 1 is cached top, then "@wed|ver|build"
	# records) so dmesg overrides them without awk -v decoding backslashes.
	out=$({ printf '%s\n%s' "$top" "$seen"; dmesg 2>/dev/null; } |
		awk '
			NR == 1 { top = $0; next }
			/^@[0-9]+\|/ { s = substr($0, 2); i = index(s, "|"); wo[substr(s, 1, i - 1)] = substr(s, i + 1); next }
			/attaching wed device [0-9]+ version / { s = $0; sub(/.*attaching wed device /, "", s); sub(/ .*/, "", s); n = s; next }
			/MTK WED WO Firmware Version: [^,]*, Build Time: / {
				s = $0; sub(/.*MTK WED WO Firmware Version: /, "", s)
				i = index(s, ", Build Time: ")
				last = substr(s, 1, i - 1) "|" substr(s, i + 14)
				if (n != "") wo[n] = last
			}
			END { print (last != "" ? last : top); for (k in wo) print k "|" wo[k] }')
	top=${out%%"$NL"*}
	recs=
	case "$out" in *"$NL"*) recs="${out#*"$NL"}$NL" ;; esac
	if [ -n "$NOW" ]; then
		tmp=$(mktemp "$WO_CACHE.XXXXXX" 2>/dev/null) || tmp=
		if [ -n "$tmp" ]; then
			cleanup_add "$tmp"
			printf '%s\n%s\n%s' "$top" "$NOW" "$recs" > "$tmp" && mv -f "$tmp" "$WO_CACHE" && cleanup_del "$tmp" || { rm -f "$tmp"; cleanup_del "$tmp"; }
		fi
	fi
	printf '%s\n%s' "$top" "$recs"
}

wed_module() {
	# The mt76 driver bound to a radio decides. kmodloader loads every
	# installed module, so a loaded module alone proves nothing.
	local p m
	for p in "$R"/sys/class/ieee80211/*/device/driver/module; do
		m=$(readlink "$p" 2>/dev/null); m=${m##*/}
		case "$m" in mt7915e|mt7996e) printf '%s' "$m"; return ;; esac
	done
	# No radio yet: MT7981/MT7986 carry a built-in WMAC driven by mt7915e,
	# MT7987/MT7988 boards use mt7996e PCIe cards.
	case "$(soc_compatible)" in
		*mt7981*|*mt7986*) printf 'mt7915e' ;;
		*) printf 'mt7996e' ;;
	esac
}

# Decode the two formats kmodloader reads. modules.conf strips comments and
# accepts whitespace before "options". Autoload files split at their first
# literal space, keep '#' in the arguments, and accept module paths/.ko names.
# Sharing this with the writer keeps the displayed setting and saved one alike.
WED_LINES_AWK='
function wed_conf(line,   i) {
	WA_CMD = WA_NAME = WA_ARGS = WA_SUFFIX = ""
	WA_HAS_ARGS = 0
	i = index(line, "#")
	if (i) { WA_SUFFIX = substr(line, i); line = substr(line, 1, i - 1) }
	sub(/^[[:space:]]*/, "", line); sub(/[[:space:]]*$/, "", line)
	i = match(line, /[ \t]/)
	if (!i) return 0
	WA_CMD = substr(line, 1, i - 1); line = substr(line, i + 1)
	sub(/^[[:space:]]*/, "", line)
	i = match(line, /[ \t]/)
	WA_NAME = i ? substr(line, 1, i - 1) : line
	WA_ARGS = i ? substr(line, i + 1) : ""
	sub(/^[[:space:]]*/, "", WA_ARGS)
	WA_HAS_ARGS = WA_ARGS != ""
	return WA_NAME != ""
}
function wed_line(line, conf,   i, name) {
	if (conf == 2) {
		if (wed_line(line, 1)) return 1
		return wed_line(line, 0)
	}
	WA_CONF = conf
	WA_PREFIX = WA_ARGS = WA_SUFFIX = ""
	if (conf) {
		if (!wed_conf(line) || WA_CMD != "options" || WA_NAME != mod) return 0
		WA_PREFIX = "options " mod
	} else {
		i = index(line, " ")
		WA_PREFIX = i ? substr(line, 1, i - 1) : line
		name = WA_PREFIX; sub(/.*\//, "", name); sub(/\.ko.*/, "", name)
		if (name != mod) return 0
		WA_ARGS = i ? substr(line, i + 1) : ""
		WA_HAS_ARGS = i > 0
	}
	return 1
}
'

# Effective explicit WED value at the normal boot stages, or null when unset
# or invalid. Early modules load first. In each directory numeric (and lower
# ASCII) file names load immediately; other names collect options until the
# final pass. Once this module loads, later entries cannot change its options.
wed_configured() {
	local mod="$1" f value
	set -- mode=conf /dev/null
	[ ! -f "$MODCONF" ] || set -- "$@" "$MODCONF"
	set -- "$@" mode=boot
	for f in "$R"/etc/modules-boot.d/*; do [ ! -f "$f" ] || set -- "$@" "$f"; done
	set -- "$@" mode=auto
	for f in "$R"/etc/modules.d/*; do [ ! -f "$f" ] || set -- "$@" "$f"; done
	value=$(LC_ALL=C awk -v mod="$mod" "$KARGS_AWK$WED_LINES_AWK"'
		function consume(line,   name) {
			if (mode == "conf" && wed_conf(line) && WA_CMD == "blacklist" && WA_NAME == mod) blocked = 1
			if (done[mode] || !wed_line(line, mode == "conf")) return
			seen[mode] = 1
			if (WA_HAS_ARGS) {
				args[mode] = gotopts[mode] ? args[mode] " " WA_ARGS : WA_ARGS
				gotopts[mode] = 1
			}
			name = FILENAME; sub(/.*\//, "", name)
			if (mode != "conf" && substr(name, 1, 1) <= "9") done[mode] = 1
		}
		{
			# load_options() uses fgets(buf, 512): each 511-byte chunk
			# is parsed as a separate record, including a split quoted value.
			if (mode == "conf") {
				for (offset = 1; offset <= length($0); offset += 511) consume(substr($0, offset, 511))
			} else consume($0)
		}
		END {
			m = seen["boot"] ? "boot" : seen["auto"] ? "auto" : "conf"
			# kmodloader joins options before the kernel parses any quotes.
			combined = args["conf"]
			if (m != "conf" && gotopts[m]) combined = gotopts["conf"] ? combined " " args[m] : args[m]
			n = kargs(combined, t)
			for (j = 1; j <= n; j++) {
				karg(t[j]); if (KSTOP) break; if (KN != "wed_enable") continue
				v = KV; have = 1
				if (KV !~ /^([eEyYtT1dDnNfF0]|[oO][nNfF])/) bad = 1
			}
			if (blocked || bad) print "!"
			else if (have) print "v" v
		}' "$@" 2>/dev/null) || value=
	if [ -n "$value" ]; then kbool "${value#v}"; WC=$KB; else WC=null; fi
}

wed_param_json() {
	local mod live WED_RECOVERY_PATH= WED_SAVE_BUSY=0 WC=null
	mod=$(wed_module)
	rd "$R/sys/module/$mod/parameters/wed_enable"; kbool "$RD"; live=$KB
	if [ -e "$STATE/wed.lock" ] && [ ! -w "$STATE/wed.lock" ]; then
		WED_SAVE_BUSY=1
	elif [ -d "$STATE" ] && [ -w "$STATE" ]; then
		{
			if ! flock -s -n 9; then
				WED_SAVE_BUSY=1
			else
				wed_recover_if_idle
				if [ "$WED_SAVE_BUSY" = 0 ] && [ -z "$WED_RECOVERY_PATH" ]; then
					wed_configured "$mod"
				fi
			fi
			true
		} 9> "$STATE/wed.lock" 2>/dev/null || WED_SAVE_BUSY=1
	else
		wed_recover_if_idle
		if [ "$WED_SAVE_BUSY" = 0 ] && [ -z "$WED_RECOVERY_PATH" ]; then
			wed_configured "$mod"
		fi
	fi
	if [ "$WED_SAVE_BUSY" = 1 ]; then
		printf '"wed_param":{"module":"%s","active":%s,"configured":null,"saving":true}' "$mod" "$live"
		return
	fi
	if [ -n "$WED_RECOVERY_PATH" ]; then
		js "$WED_RECOVERY_PATH"
		printf '"wed_param":{"module":"%s","active":%s,"configured":null,"recovery_path":"%s"}' "$mod" "$live" "$JS"
		return
	fi
	printf '"wed_param":{"module":"%s","active":%s,"configured":%s}' "$mod" "$live" "$WC"
}

# wed_json <SoC compatible>
wed_json() {
	local d id soc ver attached rx k v rest fw recs= wo out="" first=1
	fw=$(wo_firmware)
	case "$fw" in *"$NL"*) recs="$NL${fw#*"$NL"}$NL" ;; esac
	fw=${fw%%"$NL"*}
	# A WED has the version of its Ethernet SoC (mtk_wed_add_hw()); MT7987
	# is v3 in OpenWrt's mtk_eth_soc patch. Where the SoC is not one of
	# these, the debugfs files tell: rxinfo comes with v2 and rro with v3,
	# but a missing file proves nothing (null).
	case "$1" in
		*mt7622*) soc=1 ;;
		*mt7981*|*mt7986*) soc=2 ;;
		*mt7987*|*mt7988*) soc=3 ;;
		*) soc= ;;
	esac
	for d in "$DBG"/wed[0-9]*; do
		[ -d "$d" ] || continue
		id=${d##*/wed}
		case "$id" in ''|*[!0-9]*) continue ;; esac
		while [ "${id#0}" != "$id" ] && [ "$id" != 0 ]; do id=${id#0}; done
		if [ -n "$soc" ]; then ver=$soc
		elif [ -e "$d/rro" ]; then ver=3
		elif [ -e "$d/rxinfo" ]; then ver=2
		else ver=null
		fi
		if [ -s "$d/txinfo" ] || [ -n "$(head -c 1 "$d/txinfo" 2>/dev/null)" ]; then
			attached=true
		else
			attached=false
		fi
		# Receive offload, and with it the WO firmware, runs only where the
		# driver asked for it (mtk_wed_get_rx_capa(); never on v1); its
		# buffer manager base is set up then, so a zero base is a TX-only
		# WED. A dump that cannot be read, or has no such base, leaves it
		# unknown (null).
		rx=false
		if [ $attached = true ] && [ $ver != 1 ]; then
			rx=null
			while read -r k v rest; do
				[ "$k" = WED_RX_BM_BASE ] || continue
				case "$v" in *[!0-9a-fA-F]*|'') ;; *[1-9a-fA-F]*) rx=true ;; *) rx=false ;; esac
				break
			done 2>/dev/null < "$d/rxinfo"
		fi
		wo=
		case "$recs" in *"$NL$id|"*) wo=${recs#*"$NL$id|"}; wo=${wo%%"$NL"*} ;; esac
		[ $first -eq 1 ] || out="$out,"
		first=0
		wo_json "$wo"
		out="$out{\"id\":$id,\"version\":$ver,\"attached\":$attached,\"rx\":$rx,$WJ}"
	done
	wo_json "$fw"
	printf '"wed":[%s],%s' "$out" "$WJ"
}

# wo_json <version>|<build>: the two JSON members in $WJ; no "|", no build.
wo_json() {
	local ver build=
	js "${1%%|*}"; ver=$JS
	case "$1" in *"|"*) js "${1#*|}"; build=$JS ;; esac
	WJ="\"wo_firmware\":\"$ver\",\"wo_build\":\"$build\""
}

# ── Flow offload ────────────────────────────────────────────────────────

# fw_bool <value>: true where firewall4 reads the option as true
# (parse_bool in fw4.uc); anything else is false or falls back to off.
fw_bool() {
	case "$1" in 1|on|true|yes) return 0 ;; esac
	return 1
}

# Read live fw4 nft flowtable state in a single pass.
# Sets NFT_SW and NFT_HW to true|false|null; returns 0 iff table inet fw4 was read.
nft_flow_state() {
	local out res
	NFT_SW=null; NFT_HW=null
	command -v nft >/dev/null 2>&1 || return 1
	out=$(nft -t list table inet fw4 2>/dev/null 4>&- 7<&-) || return 1
	res=$(printf '%s\n' "$out" | awk '
		{ sub(/#.*/, "") }
		$1 == "table" && $2 == "inet" && $3 == "fw4" { table_seen=1 }
		$1 == "flowtable" && $2 == "ft" && $3 == "{" { ft=1; sw=1; next }
		ft && $1 == "}" { ft=0 }
		ft && $1 == "flags" {
			for (i=2; i<=NF; i++) {
				n=split($i, words, /[,;]/)
				for (j=1; j<=n; j++) if (words[j] == "offload") hw=1
			}
		}
		END {
			if (!table_seen) exit 1
			print (sw ? "true" : "false"), (hw ? "true" : "false")
		}') || return 1
	NFT_SW=${res% *}
	NFT_HW=${res#* }
	return 0
}

flow_json() {
	local sw=null hw=null NFT_SW=null NFT_HW=null
	if uci_ro_flow; then
		sw=false
		hw=false
		if fw_bool "$UCI_FO"; then
			sw=true
			fw_bool "$UCI_FOH" && hw=true
		fi
	fi
	nft_flow_state || true
	printf '"flow_offload":{"software":%s,"hardware":%s,"live_software":%s,"live_hardware":%s}' \
		"$sw" "$hw" "$NFT_SW" "$NFT_HW"
}

get_status() {
	local skip_ppe soc
	skip_ppe=$(json_input "$1" skip_ppe)
	rd "$R/tmp/sysinfo/model"; js "$RD"
	printf '{"model":"%s",' "$JS"
	js "$(board_compatible)"; printf '"compatible":"%s",' "$JS"
	soc=$(soc_compatible)
	js "$soc"; printf '"soc":"%s",' "$JS"
	cpu_json; printf ','
	# The page gets these counters from the same snapshot as its flow rows.
	if [ "$skip_ppe" = true ]; then printf '"ppe":[]'; else ppe_json; fi
	printf ','; wed_json "$soc"
	printf ','; wed_param_json
	printf ','; flow_json
	printf '}'
}

# ── Ports ───────────────────────────────────────────────────────────────

# GDM index of an mtk_soc_eth netdev: mtk_add_mac() points the netdev's
# of_node at the mac@N child, and N is the GDM id.
gdm_of() {
	# gdm_of <sysfs dir>: the GDM index in $GDM, empty for other netdevs.
	local l
	GDM=
	l=$(readlink "$1/of_node" 2>/dev/null)
	case "$l" in *mac@[0-9]*) l=${l##*mac@}; GDM=${l%%[!0-9]*} ;; esac
}

# A DSA user port: the kernel tags it DEVTYPE=dsa (SET_NETDEV_DEVTYPE in
# net/dsa/user.c) and its iflink is the conduit's ifindex. DSA has no
# phys_port_name on current kernels, so that attribute cannot be used.
is_dsa_user() {
	# is_dsa_user <sysfs dir> <iflink>
	local c l
	if [ -r "$1/uevent" ]; then
		while IFS= read -r l; do
			[ "$l" = DEVTYPE=dsa ] && return 0
		done < "$1/uevent"
	fi
	rd "$1/ifindex"
	[ -n "$2" ] && [ "$2" != "$RD" ] || return 1
	for c in "$R"/sys/class/net/*; do
		rd "$c/ifindex"
		[ "$RD" = "$2" ] && [ -r "$c/dsa/tagging" ] && return 0
	done
	return 1
}

# Prefer netifd's underlying device: a PPP L3 device has no sysfs lower_*
# link to its Ethernet carrier. Use L3 or UCI when no main device is reported.
wan_interface() {
	local name="$1" depth="${2:-0}" device status
	[ "$depth" -lt 6 ] || return 0
	status=$(ubus -S call "network.interface.$name" status 2>/dev/null)
	device=$(jsonfilter -s "$status" -e '@.device' 2>/dev/null)
	[ -n "$device" ] || device=$(jsonfilter -s "$status" -e '@.l3_device' 2>/dev/null)
	[ -n "$device" ] || { uci_ro_read network "$name.device" && device=$UCI_VAL; }
	wan_ports "$device" "$depth"
}

# The physical port under a WAN device: a VLAN (eth2.35, or a named 8021q
# device) links to its parent as lower_<dev> in sysfs.
wan_ports() {
	# wan_ports <netdev> [depth]: append the ports under it to $WP. VLANs,
	# bridges and bonds link their members as lower_<dev>; follow them down
	# to netdevs that are ports themselves (a device or of_node). DSA user
	# ports stop there, though they list their conduit as a lower device.
	local d="$1" depth="${2:-0}" l found=0
	[ -n "$d" ] && [ "$depth" -lt 6 ] || return 0
	case "$d" in
		@*) wan_interface "${d#@}" $((depth + 1)); return 0 ;;
	esac
	if [ ! -d "$R/sys/class/net/$d" ]; then
		# Not created yet: a VLAN name still points at its port.
		case "$d" in
			*.*) wan_ports "${d%.*}" $((depth + 1)) ;;
			*) WP="$WP $d " ;;
		esac
		return 0
	fi
	if [ -e "$R/sys/class/net/$d/device" ] || [ -e "$R/sys/class/net/$d/of_node" ]; then
		WP="$WP $d "
		return 0
	fi
	for l in "$R/sys/class/net/$d"/lower_*; do
		[ -e "$l" ] || continue
		found=1
		wan_ports "${l##*/lower_}" $((depth + 1))
	done
	[ $found = 1 ] || WP="$WP $d "
	return 0
}

# Highest speed a port supports, for a label that does not change with the
# link: ethtool's supported link modes when installed, otherwise the DT
# phy-mode. "internal" is the 2.5G PHY on an MT7987/MT7988 GMAC and a 1G PHY
# on a switch port.
port_max_mbps_probe() {
	# port_max_mbps_probe <sysfs dir> <kind>: speed in $PM, media in $PMEDIA
	local m mode= out=
	PMEDIA=unknown
	if command -v ethtool >/dev/null 2>&1; then
		out=$(ethtool "${1##*/}" 2>/dev/null | awk '
			/^[ \t]*Supported ports:/ { s = $0; sub(/.*Supported ports:[ \t]*/, "", s); sup = tolower(s) }
			/^[ \t]*Port:/ { s = $0; sub(/.*Port:[ \t]*/, "", s); port = tolower(s) }
			/Supported link modes:/ { f = 1; sub(/.*:/, "") }
			f && /:/ { f = 0 }
			f { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+base/) { v = $i + 0; if (v > m) m = v } }
			END {
				media = "unknown"
				if (port ~ /fibre|fiber|direct attach|(^|[^a-z])(da|sfp)([^a-z]|$)/) media = "sfp"
				else if (port ~ /twisted pair|(^|[^a-z])tp([^a-z]|$)/) media = "rj45"
				else if (sup ~ /fibre|fiber|direct attach|(^|[^a-z])(da|sfp)([^a-z]|$)/) media = "sfp"
				else if (sup ~ /twisted pair|(^|[^a-z])tp([^a-z]|$)/) media = "rj45"
				print m + 0, media
			}')
		read -r m PMEDIA <<EOF
$out
EOF
		case "$PMEDIA" in sfp|rj45|unknown) ;; *) PMEDIA=unknown ;; esac
		[ "${m:-0}" -gt 0 ] && { PM=$m; return; }
	fi
	# A DT string property ends in NUL; read drops it.
	for m in phy-mode phy-connection-type; do
		[ -r "$1/of_node/$m" ] && { rd "$1/of_node/$m"; mode=$RD; break; }
	done
	case "$mode" in
		usxgmii|10gbase-r|10gbase-kr|xaui|rxaui) m=10000 ;;
		5gbase-r) m=5000 ;;
		2500base-x) m=2500 ;;
		internal) if [ "$2" = gdm ]; then m=2500; else m=1000; fi ;;
		sgmii|qsgmii|1000base-x|1000base-kx|gmii|rgmii*|trgmii) m=1000 ;;
		'') if [ "$2" = gsw ]; then m=1000; else m=null; fi ;;
		*) m=null ;;
	esac
	PM=$m
}

port_max_mbps() {
	local identity stamp cached_id cached_kind cached_speed cached_media tmp
	local cache="$STATE/port-${1##*/}.max"
	rd "$1/ifindex"; identity=$RD
	clock_now
	if [ -n "$NOW" ] && [ -n "$identity" ] && [ -r "$cache" ]; then
		read -r stamp cached_id cached_kind cached_speed cached_media < "$cache"
		case "$stamp:$cached_speed" in
			*[!0-9:]*|:*|*:) ;;
			*) case "$cached_media" in sfp|rj45|unknown)
				if [ "$cached_id" = "$identity" ] && [ "$cached_kind" = "$2" ] &&
					[ "$NOW" -ge "$stamp" ] && [ $((NOW - stamp)) -lt 60 ]; then
					PM=$cached_speed; PMEDIA=$cached_media; return
				fi ;;
			esac ;;
		esac
	fi
	port_max_mbps_probe "$1" "$2"
	# Unknown capabilities are retried, not pinned during device startup.
	case "$PM" in ''|*[!0-9]*) return ;; esac
	[ -n "$NOW" ] && [ -n "$identity" ] || return 0
	tmp=$(mktemp "$cache.XXXXXX" 2>/dev/null) || return 0
	cleanup_add "$tmp"
	printf '%s %s %s %s %s\n' "$NOW" "$identity" "$2" "$PM" "$PMEDIA" > "$tmp" &&
		mv -f "$tmp" "$cache" && cleanup_del "$tmp" || { rm -f "$tmp"; cleanup_del "$tmp"; }
}

port_json() {
	# port_json <sysfs dir> <role> <kind> <gdm> <conduit>: the object in $PJ
	local n="$1" speed carrier name conduit duplex k stats=
	ri "$n/carrier" null; carrier=$RI
	ri "$n/speed" null; speed=$RI
	[ "$carrier" = 1 ] || speed=null
	case "$speed" in ''|0*|*[!0-9]*) speed=null ;; esac
	js "${n##*/}"; name=$JS
	js "$5"; conduit=$JS
	rd "$n/duplex"; js "$RD"; duplex=$JS
	port_max_mbps "$n" "$3"
	for k in rx_bytes tx_bytes rx_packets tx_packets rx_errors tx_errors rx_dropped tx_dropped; do
		ri "$n/statistics/$k" null
		stats="$stats,\"$k\":$RI"
	done
	PJ="{\"netdev\":\"$name\",\"role\":\"$2\",\"kind\":\"$3\",\"gdm\":${4:-null},\"conduit\":\"$conduit\",\"carrier\":$carrier,\"speed_mbps\":$speed,\"max_mbps\":$PM,\"media\":\"$PMEDIA\",\"duplex\":\"$duplex\"$stats}"
}

get_ports() {
	local wan n i c drv gdm role kind conduit out="" first=1 iflink
	WP=
	wan_interface wan
	wan_interface wan6
	wan=$WP
	for n in "$R"/sys/class/net/*; do
		i=${n##*/}
		[ -e "$n/device" ] || [ -e "$n/of_node" ] || continue
		gdm=""; conduit=""
		rd "$n/iflink"; iflink=$RD
		if is_dsa_user "$n" "$iflink"; then
			kind=gsw
			if [ -n "$iflink" ]; then
				for c in "$R"/sys/class/net/*; do
					rd "$c/ifindex"
					[ "$RD" = "$iflink" ] && { conduit=${c##*/}; gdm_of "$c"; gdm=$GDM; break; }
				done
			fi
		else
			gdm_of "$n"; gdm=$GDM
			if [ -z "$gdm" ]; then
				drv=$(readlink "$n/device/driver" 2>/dev/null)
				[ "${drv##*/}" = mtk_soc_eth ] || continue
			fi
			kind=gdm
		fi
		case "$wan" in *" $i "*) role=wan ;; *) role=lan ;; esac
		# A DSA conduit only feeds the switch; it is not a user-facing port.
		[ "$kind" = gdm ] && [ -r "$n/dsa/tagging" ] && role=conduit
		[ $first -eq 1 ] || out="$out,"
		first=0
		port_json "$n" "$role" "$kind" "$gdm" "$conduit"
		out="$out$PJ"
	done
	printf '{"compatible":"%s","model":"%s","ports":[%s]}' \
		"$(json_str "$(board_compatible)")" "$(json_str "$(read_first "$R/tmp/sysinfo/model")")" "$out"
}

# GDM MAC counters from ethtool -S (mtk_ethtool_stats[] in mtk_eth_soc.c).
get_mac_stats() {
	local n i gdm raw rc out="" first=1
	if ! command -v ethtool >/dev/null 2>&1; then
		printf '{"available":false,"reason":"ethtool_missing","macs":[]}'
		return
	fi
	for n in "$R"/sys/class/net/*; do
		i=${n##*/}
		gdm_of "$n"; gdm=$GDM
		[ -n "$gdm" ] || continue
		[ $first -eq 1 ] || out="$out,"
		first=0
		# The name is escaped here: awk -v would also read its backslashes.
		js "$i"
		raw=$(ethtool -S "$i" 2>/dev/null); rc=$?
		out="$out{\"netdev\":\"$JS\",\"gdm\":$gdm$(printf '%s\n' "$raw" | awk -v rc="$rc" '
			BEGIN { split("tx_bytes tx_packets tx_skip tx_collisions rx_bytes rx_packets rx_overflow rx_fcs_errors rx_short_errors rx_long_errors rx_checksum_errors rx_flow_control_packets", k, " ") }
			rc == 0 { gsub(/^[ \t]+|:$/, "", $1); key = $1; sub(/:$/, "", key); v[key] = $2 }
			END {
				for (j = 1; j in k; j++) if (rc == 0 && k[j] in v && v[k[j]] ~ /^[0-9]+$/) got++
				printf ",\"ok\":%s", (rc == 0 && got > 0 ? "true" : "false")
				for (j = 1; j in k; j++) printf ",\"%s\":%s", k[j], ((rc == 0 && k[j] in v && v[k[j]] ~ /^[0-9]+$/) ? sprintf("%.0f", v[k[j]] + 0) : "null")
			}')}"
	done
	printf '{"available":true,"macs":[%s]}' "$out"
}

# ── Wi-Fi ───────────────────────────────────────────────────────────────
# Per-band client health from iw, same computation as luci-app-airoha-npu.

# Normalize one interface and its stations. iw prints top-level statistics
# followed by per-link statistics for an MLO station; only one level is used.
# I = band/interface, U = unique station, C = counters, P = incomplete mapping.
wifi_records() {
	# The interface name is data on stdin: awk -v would decode backslashes.
	printf '%s\n%s\n#STATIONS\n%s\n' "$1" "$2" "$3" | awk '
		function band(f) { return f >= 5925 ? 2 : f >= 5000 ? 1 : 0 }
		function value(s, k) { return ((s SUBSEP k) in v) ? v[s, k] : "-" }
		function emit(s, b, key,   ct, sig) {
			ct = value(s, "ct"); if (ct == "-") ct = value("top", "ct")
			sig = value(s, "sig"); if (sig == "-") sig = value(s, "sig_cur")
			print "C", b, iface, key, value(s, "tx"), ct, value(s, "pk"),
				value(s, "rt"), value(s, "fl"), value(s, "phy"), value(s, "ex"), sig
		}
		function flush_station(   l) {
			if (mac == "") return
			print "U", iface, mac
			if (have_links) {
				for (l in links) {
					if (!(l in bands)) { print "P"; continue }
					emit(l, bands[l], mac "/" l "/" ((l in addresses) ? addresses[l] : "-"))
				}
			} else if (band_count == 1 && !unmapped) emit("top", only_band, mac)
			else print "P"
		}
		NR == 1 { iface = $0; next }
		!stations && $0 == "#STATIONS" {
			stations = 1
			if (!mlo && have_channel) active[default_band] = 1
			for (b = 0; b < 3; b++) if (b in active) { print "I", b, iface; band_count++; only_band = b }
			for (l in configured) if (!(l in bands)) unmapped = 1
			next
		}
		!stations {
			if ($1 == "MLD" && $2 == "with" && $3 == "links:") { mlo = 1; id = "" }
			if ($1 == "-" && $2 == "link") {
				mlo = 1; id = ""
				if ($3 == "ID" && $4 ~ /^[0-9]+$/) { id = $4 + 0; configured[id] = 1 }
				else unmapped = 1
			}
			if ($1 == "channel") {
				f = $3; sub(/^\(/, "", f)
				if (f ~ /^[0-9]+$/ && f + 0 > 1000) {
					if (mlo && id != "") { bands[id] = band(f); active[bands[id]] = 1 }
					else if (!mlo) { have_channel = 1; default_band = band(f) }
				}
			}
			next
		}
		/^Station / {
			flush_station(); delete v; delete links; delete addresses
			mac = $2; section = "top"; have_links = 0; next
		}
		mac == "" { next }
		$1 == "Link" && $2 ~ /^[0-9]+:$/ {
			section = $2; sub(/:$/, "", section); section += 0
			links[section] = 1; have_links = 1; next
		}
		$1 == "address:" && section != "top" { addresses[section] = $2; next }
		$1 == "tx" && $3 ~ /^[0-9]+$/ {
			if ($2 == "bytes:") v[section, "tx"] = $3
			else if ($2 == "packets:") v[section, "pk"] = $3
			else if ($2 == "retries:") v[section, "rt"] = $3
			else if ($2 == "failed:") v[section, "fl"] = $3
		}
		$1 == "connected" && $2 == "time:" && $3 ~ /^[0-9]+$/ { v[section, "ct"] = $3 }
		$1 == "tx" && $2 == "bitrate:" && $3 + 0 > 0 { v[section, "phy"] = $3 + 0 }
		$1 == "expected" && $2 == "throughput:" && $3 + 0 > 0 { v[section, "ex"] = $3 + 0 }
		$1 == "signal:" && $2 ~ /^-[0-9]+$/ { v[section, "sig_cur"] = $2 }
		$1 == "signal" && $2 == "avg:" && $3 ~ /^-[0-9]+$/ { v[section, "sig"] = $3 }
		END { flush_station() }
	'
}

get_wifi_stats() {
	local iface records d now end rest late rates snap list raw_dev info prev f try body old partial=0 hw=false cur=""
	local rate0 rate1 rate2 tag previous_time previous_end
	for d in "$R"/sys/class/ieee80211/*; do
		[ -e "$d" ] && { hw=true; break; }
	done
	if ! command -v iw >/dev/null 2>&1; then
		if [ "$hw" = true ]; then
			printf '{"available":false,"reason":"iw_missing","has_wifi":true,"bands":[]}'
		else
			printf '{"available":true,"has_wifi":false,"complete":true,"stations":0,"bands":[]}'
		fi
		return
	fi
	read -r now rest 2>/dev/null < "$R/proc/uptime"
	raw_dev=$(iw dev 2>/dev/null) ||
		{ printf '{"available":false,"has_wifi":%s,"error":"iw dev failed","bands":[]}' "$hw"; return; }
	case "$raw_dev" in *[![:space:]]*) hw=true ;; esac
	if [ "$hw" = false ]; then
		printf '{"available":true,"has_wifi":false,"complete":true,"stations":0,"bands":[]}'
		return
	fi
	# "Interface" and "type" are the first words of their lines; the SSID
	# line in between may contain the same words. AP/VLAN carries the WDS
	# stations of an AP.
	list=$(printf '%s\n' "$raw_dev" | awk '
		$1 == "Interface" { i = $2; next }
		$1 == "type" {
			if (($2 == "AP" || $2 == "AP/VLAN") && i != "" && !(i in seen)) { seen[i]; print i }
			i = ""
		}') || { printf '{"available":false,"has_wifi":%s,"error":"cannot parse Wi-Fi interfaces","bands":[]}' "$hw"; return; }
	if [ -z "$list" ]; then
		printf '{"available":true,"has_wifi":true,"complete":true,"stations":0,"bands":[]}'
		return
	fi
	# Valid interface names can contain glob characters and backslashes.
	while IFS= read -r iface; do
		[ -n "$iface" ] || continue
		# A failed query leaves the sample incomplete: it is reported and
		# never becomes the rate baseline.
		info=$(iw dev "$iface" info 2>/dev/null) || { partial=1; continue; }
		d=$(iw dev "$iface" station dump 2>/dev/null) || { partial=1; continue; }
		records=$(wifi_records "$iface" "$info" "$d") || { partial=1; continue; }
		cur="$cur$records$NL"
	done <<EOF
$list
EOF
	case "$NL$cur$NL" in *"${NL}P${NL}"*) partial=1 ;; esac

	read -r end rest 2>/dev/null < "$R/proc/uptime"
	# The sample (time, rates, per-client TX bytes) is shared by every open
	# page. A rate adds up the growth of clients present in both samples, so
	# clients leaving or joining do not swing it. A sample taken less than
	# WIFI_MIN_DT after the newest one, older than it, incomplete or read
	# over more than WIFI_MAX_SPAN returns the stored rates and is not kept.
	prev=
	for try in 1 2 3; do
		# A newer writer may prune the file just picked; pick again.
		f=
		for prev in "$WIFI_SNAP"/[0-9]*; do [ -f "$prev" ] && f=$prev; done
		prev=
		[ -n "$f" ] || break
		prev=$(cat "$f" 2>/dev/null) && [ -n "$prev" ] && break
		prev=
	done
	snap=$(printf '%s\n%s' "$prev" "$cur" | awk -v now="${now:-0}" -v end="${end:-${now:-0}}" -v span="$WIFI_MAX_SPAN" \
		-v min="$WIFI_MIN_DT" -v partial="$partial" '
		# T <start> <rates> <end>: counters were read between start and end
		$1 == "T" { pt = $2; pr[0] = $3; pr[1] = $4; pr[2] = $5; pe = ($6 != "" ? $6 : $2); next }
		$1 == "S" { k = $3 " " $4; ptx[k] = $5; pb[k] = $2; next }
		$1 == "C" && $5 ~ /^[0-9]+$/ { k = $3 " " $4; ctx[k] = $5; cb[k] = $2; cct[k] = $6; next }
		END {
			late = end - now > span
			r[0] = r[1] = r[2] = "0.0"; save = !partial && !late
			if (pt > 0) {
				dt = now - pt
				if (partial || late || dt < min) {
					save = 0; r[0] = pr[0]; r[1] = pr[1]; r[2] = pr[2]
				} else {
					# The two reads of a client lie at least gap apart, and
					# "connected time" is whole seconds: only a session a
					# full second shorter than gap surely began after the
					# last read (a reconnect). Counting an unsure one cannot
					# overstate the rate, its counter restarted.
					gap = now - pe
					for (k in ctx) {
						if (!(k in ptx) || pb[k] != cb[k] || (cct[k] != "-" && cct[k] + 1 <= gap)) continue
						d = ctx[k] - ptx[k]
						if (d > 0) s[cb[k]] += d
					}
					for (b = 0; b < 3; b++) r[b] = sprintf("%.1f", s[b] / dt / 125000)
				}
			}
			print r[0], r[1], r[2], late
			if (save) {
				printf "%012.0f\n", now * 100
				printf "T %s %s %s %s %s\n", now, r[0], r[1], r[2], end
				for (k in ctx) printf "S %s %s %s\n", cb[k], k, ctx[k]
			}
		}') || {
		# Keep the previous rates and baseline when the calculator fails.
		partial=1
		read -r tag previous_time rate0 rate1 rate2 previous_end <<EOF
$prev
EOF
		snap="${rate0:-0} ${rate1:-0} ${rate2:-0} 0"
	}
	rates=${snap%%"$NL"*}
	case "$snap" in
		*"$NL"*)
			body=${snap#*"$NL"}
			f=${body%%"$NL"*}
			body=${body#*"$NL"}
			mkdir -p "$WIFI_SNAP" 2>/dev/null
			if printf '%s\n' "$body" 2>/dev/null > "$WIFI_SNAP/.$$" &&
				mv -f "$WIFI_SNAP/.$$" "$WIFI_SNAP/$f" 2>/dev/null; then
				# Keep the three newest: a reader that picked one a moment
				# ago can still open it.
				set -- "$WIFI_SNAP"/[0-9]*
				old=''
				while [ $# -gt 3 ]; do old="$old $1"; shift; done
				# shellcheck disable=SC2086
				[ -z "$old" ] || rm -f $old
			else
				# No stored sample means no baseline for the next rate.
				rm -f "$WIFI_SNAP/.$$"
				partial=1
			fi
			;;
	esac

	read -r rate0 rate1 rate2 late <<EOF
$rates
EOF
	# A sample read too slowly is reported like a partial one.
	[ "$late" = 1 ] && partial=1
	printf '%s\n' "$cur" | awk -v partial="$partial" -v has_wifi="$hw" -v r0="${rate0:-0}" -v r1="${rate1:-0}" -v r2="${rate2:-0}" "$JESC_AWK"'
		$1 == "I" {
			b = $2; k = b " " $3
			if (!(k in interfaces)) { interfaces[k] = 1; ifs[b] = ifs[b] (ifs[b] == "" ? "" : " ") $3 }
		}
		$1 == "U" { clients[$2 " " $3] = 1 }
		$1 == "C" {
			b = $2; split($4, station, "/"); k = b " " $3 " " station[1]
			if (!(k in seen)) { seen[k] = 1; st[b]++ }
			pk[b] += $7; rt[b] += $8; fl[b] += $9
			if ($10 + 0 > 0) { phy[b] += $10; pn[b]++ }
			if ($11 + 0 > 0) { ex[b] += $11; en[b]++ }
			if ($10 + 0 > 0 && $11 + 0 > 0) { pphy[b] += $10; pex[b] += $11 }
			if ($12 ~ /^-[0-9]+$/) { ss[b] += $12; sn[b]++; if (sn[b] == 1 || $12 + 0 < mn[b]) mn[b] = $12 + 0 }
		}
		END {
			for (k in clients) total++
			printf "{\"available\":true,\"has_wifi\":%s,\"complete\":%s,\"stations\":%d,\"bands\":[", has_wifi, (partial ? "false" : "true"), total
			for (b = 0; b < 3; b++) {
				if (!(b in ifs)) continue
				ap = pn[b] ? phy[b] / pn[b] : 0; ae = en[b] ? ex[b] / en[b] : 0
				if (pphy[b] > 0) {
					ef = int(pex[b] / pphy[b] * 100 + 0.5)
					if (ef < 0) ef = 0; else if (ef > 100) ef = 100
					eff = sprintf("%d", ef)
				} else eff = "null"
				asig = sn[b] ? sprintf("%d", int(ss[b] / sn[b])) : "null"
				msig = sn[b] ? sprintf("%d", mn[b]) : "null"
				printf "%s{\"band\":%d,\"interfaces\":\"%s\",\"stations\":%d,\"tx_packets\":%.0f,\"tx_retries\":%.0f,\"tx_failed\":%.0f,\"avg_phy_rate\":%.1f,\"avg_exp_throughput\":%.1f,\"airtime_efficiency\":%s,\"avg_signal\":%s,\"min_signal\":%s,\"tx_mbps\":%s}",
					(n++ ? "," : ""), b, jesc(ifs[b]), st[b], pk[b], rt[b], fl[b], ap, ae,
					eff, asig, msig, (b == 0 ? r0 : b == 1 ? r1 : r2)
			}
			printf "]}"
		}'
}

# ── Setters ─────────────────────────────────────────────────────────────

# Seconds a save waits for another one to finish.
SETTINGS_LOCK_WAIT=10

# locked <setter> <input>: run setters one at a time, from their checks to
# the commit, so two pages saving at once cannot leave the applied settings
# from one request and the saved ones from the other. The lock is on fd 4.
locked() {
	local i=0 rc
	{
		while :; do
			flock -n 4 && break
			rc=$?
			[ $rc = 1 ] || { printf '{"error":"cannot lock the settings"}'; return 0; }
			[ $i -lt $SETTINGS_LOCK_WAIT ] || { printf '{"error":"another save is in progress"}'; return 0; }
			i=$((i + 1))
			sleep 1
		done
		"$@"
		return 0
	} 4> "$STATE/settings.lock" || printf '{"error":"cannot lock the settings"}'
}

# Check whether procd has a firewall config.change reload trigger registered.
rpcd_has_fw_trigger() {
	local out tr
	out=$(ubus -S call service list '{"name":"firewall","verbose":true}' 2>/dev/null 4>&-) || return 2
	tr=$(jsonfilter -s "$out" -e '@.firewall.triggers[*]' 2>/dev/null)
	if [ -n "$tr" ]; then
		while IFS= read -r out; do
			case "$out" in
				*'"config.change"'*'"firewall"'*) return 0 ;;
			esac
		done <<EOF
$tr
EOF
		return 1
	fi
	case "$out" in
		*'"triggers":'*'"config.change"'*'"firewall"'*) return 0 ;;
	esac
	return 1
}

# A missing ft in a readable fw4 table is a valid disabled state. An nft
# error (including an unreadable/missing fw4 table) cannot verify either state.
nft_offload_matches() {
	local NFT_SW NFT_HW
	nft_flow_state || return 1
	case "$1" in
		1) [ "$NFT_HW" = true ] ;;
		0) [ "$NFT_HW" = false ] ;;
		*) return 1 ;;
	esac
}

# Wait briefly for /var/run/fw4.lock release (shared flock on FD 8, immediately closed).
fw4_wait_lock() {
	local wait_sec="$1" lrc
	[ -e "$FW4_LOCK" ] || return 0
	if { command exec 8< "$FW4_LOCK"; } 2>/dev/null; then
		flock_wait s 8 "$wait_sec"
		lrc=$?
		exec 8<&-
		return "$lrc"
	fi
	return 1
}

# Wait for procd-triggered fw4 reload to finish and verify live state + nft.
# Caller holds FD 7 on pre-commit $FW4_STATE iff $had_state=1.
fw4_wait_reload() {
	local en="$1" had_state="$2" wait_max="${3:-$FW_RELOAD_WAIT}" i=0 rotated=0 rem
	while :; do
		if [ "$had_state" = 1 ]; then
			if [ ! -e /proc/self/fd/7 ] || [ ! /proc/self/fd/7 -ef "$FW4_STATE" ]; then
				rotated=1
				break
			fi
		else
			if [ -f "$FW4_STATE" ]; then
				rotated=1
				break
			fi
		fi
		[ "$i" -lt "$wait_max" ] || break
		i=$((i + 1))
		sleep 1
	done
	[ "$rotated" = 1 ] || return 1
	rem=$((wait_max - i))
	[ "$rem" -ge 1 ] || rem=1
	fw4_wait_lock "$rem" || return 1
	[ -f "$FW4_STATE" ] || return 1
	nft_offload_matches "$en"
}

# Pin the pre-commit inode until the asynchronous reload has replaced it.
# A missing state file is handled by waiting for its creation instead.
fw_prepare_reload() {
	exec 7<&-
	had_state=0
	if [ "$trigger" = 1 ] && [ "$fw4" = 1 ] && [ -e "$FW4_STATE" ]; then
		{ command exec 7< "$FW4_STATE"; } 2>/dev/null || return 1
		had_state=1
	fi
	return 0
}

fw_finish_reload() {
	if [ "$trigger" = 1 ] && [ "$fw4" = 1 ]; then
		fw4_wait_reload "$1" "$had_state" "$2"
	else
		"$FW_INIT" reload >/dev/null 2>&1 4>&- 7<&- || return 1
		[ "$fw4" = 0 ] || nft_offload_matches "$1"
	fi
}

# apply/confirm/rollback operate on the private SID's transaction.
# get/set/commit additionally require the firewall package name.
flow_uci() {
	local args="$2"
	case "$1" in
		get|set|commit) args='"config":"firewall"'${args:+,$args} ;;
	esac
	ubus -S call uci "$1" "{\"ubus_rpc_session\":\"$sid\"${args:+,$args}}" 2>/dev/null 4>&- 7<&-
}

flow_read_section() {
	local out
	out=$(flow_uci get '"section":"@defaults[0]"') || return 1
	section=$(jsonfilter -s "$out" -e '@.values[".name"]' 2>/dev/null) || return 1
	case "$section" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	[ "$(jsonfilter -s "$out" -e '@.values[".type"]' 2>/dev/null)" = defaults ] || return 1
	RPCD_HAD_FO=0; RPCD_HAD_FOH=0
	if RPCD_FO=$(jsonfilter -s "$out" -e '@.values.flow_offloading' 2>/dev/null); then RPCD_HAD_FO=1; fi
	if RPCD_FOH=$(jsonfilter -s "$out" -e '@.values.flow_offloading_hw' 2>/dev/null); then RPCD_HAD_FOH=1; fi
}

# Read back disk, independent of any delta still visible to the writer.
flow_disk_matches() {
	uci_ro_flow || return 1
	[ "$UCI_HAD_FOH" = 1 ] && [ "$UCI_FOH" = "$en" ] || return 2
	[ "$en" = 0 ] || { [ "$UCI_HAD_FO" = 1 ] && [ "$UCI_FO" = 1 ]; } || return 2
	return 0
}

# rpcd owns the snapshot and keeps other sessions' commit calls out until
# rollback completes. Read the committed file: our session regains its delta.
flow_rollback() {
	local rc old_en=0 pinned=1 restored=1 live_ok=0 wait_cap="$FW_RELOAD_WAIT"
	fw_prepare_reload || pinned=0
	flow_uci rollback >/dev/null
	rc=$?
	CLEANUP_FLOW_APPLY=

	# Fast-exit when disk does not show the pre-change values.
	uci_ro_flow || return 1
	[ "$UCI_HAD_FO" = "$had_fo" ] && [ "$UCI_FO" = "$prev_fo" ] &&
		[ "$UCI_HAD_FOH" = "$had_foh" ] && [ "$UCI_FOH" = "$prev_foh" ] || restored=0
	[ "$restored" = 1 ] || return 1
	if fw_bool "$UCI_FO" && fw_bool "$UCI_FOH"; then old_en=1; fi

	# Reconcile live runtime whenever disk is restored, including lost replies
	# (rc!=0) so trigger=0 manual reloads never leave new fw4 rules active.
	if [ "$trigger" = 1 ] && [ "$rc" != 0 ]; then
		# The timeout or lost-reply event may have completed before we pinned the inode.
		if fw4_wait_lock "$FW_RELOAD_WAIT" && nft_offload_matches "$old_en"; then
			live_ok=1
		fi
		[ "$wait_cap" -le 3 ] || wait_cap=3
	fi
	if [ "$live_ok" = 0 ] && [ "$pinned" = 1 ] && fw_finish_reload "$old_en" "$wait_cap"; then
		live_ok=1
	fi
	[ "$rc" = 0 ] || [ "$rc" = 5 ] || return 1
	[ "$live_ok" = 1 ] || return 3
}

set_flow_offload_rpcd_body() {
	local en="$1" out sid section selector vals= trigger=0 fw4=0 had_state=0 rc failure
	local had_fo prev_fo had_foh prev_foh

	out=$(ubus -S call session create '{"timeout":120}' 2>/dev/null 4>&-) || {
		printf '{"error":"cannot save the firewall settings"}'; return
	}
	sid=$(jsonfilter -s "$out" -e '@.ubus_rpc_session' 2>/dev/null)
	case "$sid" in ''|*[!a-f0-9]*) printf '{"error":"cannot save the firewall settings"}'; return ;; esac
	[ "${#sid}" = 32 ] && [ "$sid" != 00000000000000000000000000000000 ] || {
		printf '{"error":"cannot save the firewall settings"}'; return
	}
	CLEANUP_RPCD_SID=$sid
	# Wrapper and signal traps destroy the session and discard its private stage.
	if ! ubus -S call session grant "{\"ubus_rpc_session\":\"$sid\",\"scope\":\"uci\",\"objects\":[[\"firewall\",\"read\"],[\"firewall\",\"write\"]]}" >/dev/null 2>&1 4>&- ||
		! flow_read_section; then
		printf '{"error":"cannot save the firewall settings"}'; return
	fi
	selector="\"section\":\"$section\""
	had_fo=$RPCD_HAD_FO; prev_fo=$RPCD_FO
	had_foh=$RPCD_HAD_FOH; prev_foh=$RPCD_FOH
	if [ "$en" = 1 ] && [ "$prev_fo" != 1 ]; then
		vals='"flow_offloading":"1"'
	fi
	if [ "$prev_foh" != "$en" ]; then
		vals="${vals:+$vals,}\"flow_offloading_hw\":\"$en\""
	fi
	command -v fw4 >/dev/null 2>&1 && fw4=1
	if [ -z "$vals" ] && [ "$fw4" = 1 ] && nft_offload_matches "$en" && flow_disk_matches; then
		printf '{"result":"ok","enabled":%s}' "$en"; return
	fi
	if [ "$fw4" = 1 ]; then
		rpcd_has_fw_trigger
		case "$?" in
			0) trigger=1 ;;
			2) printf '{"error":"cannot determine the firewall reload trigger"}'; return ;;
		esac
	fi
	if [ -n "$vals" ] && ! flow_uci set "$selector,\"values\":{$vals}" >/dev/null; then
		printf '{"error":"cannot save the firewall settings"}'; return
	fi
	fw_prepare_reload || { printf '{"error":"cannot save the firewall settings"}'; return; }
	if [ -z "$vals" ]; then
		# No private delta. A package commit emits the reload event while
		# respecting any pending apply. There is no write to compensate.
		flow_uci commit >/dev/null
		rc=$?
	else
		CLEANUP_FLOW_MANUAL=$((1 - trigger))
		CLEANUP_FLOW_APPLY=1
		# Keep the daemon timer shorter than the session TTL (120 seconds).
		flow_uci apply '"rollback":true,"timeout":60' >/dev/null
		rc=$?
	fi
	case "$rc" in
		0) ;;
		6) CLEANUP_FLOW_APPLY=
			printf '{"error":"firewall settings are locked by another pending apply"}'; return ;;
		*) # A lost reply may follow a successful apply. Cleanup can only
		   # abort our SID, and can never release someone else's transaction.
			printf '{"error":"cannot save the firewall settings"}'; return ;;
	esac

	if ! flow_disk_matches; then
		failure=save
	elif ! fw_finish_reload "$en"; then
		failure=reload
	elif ! flow_disk_matches; then
		failure=save
	elif [ -n "$vals" ] && ! flow_uci confirm >/dev/null; then
		failure=confirm
	else
		CLEANUP_FLOW_APPLY=
		printf '{"result":"ok","enabled":%s}' "$en"; return
	fi

	if [ -z "$vals" ]; then
		case "$failure" in
			reload) printf '{"error":"could not apply the saved flow offload setting"}' ;;
			*) printf '{"error":"cannot verify the committed firewall settings"}' ;;
		esac
		return
	fi

	flow_rollback
	case "$?" in
		0) case "$failure" in
			reload) printf '{"error":"firewall reload failed; flow offload setting reverted"}' ;;
			confirm) printf '{"error":"firewall transaction confirmation failed; previous settings restored"}' ;;
			*) printf '{"error":"firewall settings verification failed; previous settings restored"}' ;;
		esac ;;
		3) printf '{"error":"firewall settings restored; could not verify firewall reload"}' ;;
		*) printf '{"error":"could not verify firewall transaction rollback"}' ;;
	esac
}

set_flow_offload_rpcd() {
	set_flow_offload_rpcd_body "$1"
	exec 7<&-
	rpcd_session_destroy
}

set_flow_offload_cas() {
	local en="$1" had_fo=0 had_foh=0 prev_fo= prev_foh= changed_fo=0 changed_foh=0
	local op_fo=keep rb_fo=keep rb_foh=keep rb_rc
	local UCI_SNAP_FLOW=1 UCI_FO= UCI_HAD_FO=0 UCI_FOH= UCI_HAD_FOH=0
	local UCI_EXPECT_FLOW=0 UCI_EXP_CHK_FO=0 UCI_EXP_FO=1 UCI_EXP_FOH="$en"
	# Hardware offload rides on the software flowtable, so enabling it turns
	# both on; disabling only drops the hardware part. UCI_SNAP_FLOW=1 records
	# pre-change committed values inside the winning CAS attempt.
	[ "$en" = 0 ] || op_fo='set:@defaults[0].flow_offloading=1'
	if ! uci_pkg_apply firewall "$op_fo" "set:@defaults[0].flow_offloading_hw=$en"; then
		printf '{"error":"cannot save the firewall settings"}'
		return
	fi
	had_fo=$UCI_HAD_FO; prev_fo=$UCI_FO
	had_foh=$UCI_HAD_FOH; prev_foh=$UCI_FOH
	[ "$en" = 1 ] && { [ "$had_fo" != 1 ] || [ "$prev_fo" != 1 ]; } && changed_fo=1
	{ [ "$had_foh" != 1 ] || [ "$prev_foh" != "$en" ]; } && changed_foh=1
	# fw4 rebuilds its flowtable on reload; only a finished reload applies it.
	# Nothing it starts may inherit the settings lock.
	if ! "$FW_INIT" reload >/dev/null 2>&1 4>&-; then
		UCI_SNAP_FLOW=0
		UCI_EXPECT_FLOW=1
		UCI_EXP_CHK_FO=$changed_fo
		if [ "$changed_fo" = 1 ]; then
			if [ "$had_fo" = 1 ]; then rb_fo="set:@defaults[0].flow_offloading=$prev_fo"
			else rb_fo='del:@defaults[0].flow_offloading'
			fi
		fi
		if [ "$changed_foh" = 1 ]; then
			if [ "$had_foh" = 1 ]; then rb_foh="set:@defaults[0].flow_offloading_hw=$prev_foh"
			else rb_foh='del:@defaults[0].flow_offloading_hw'
			fi
		fi
		uci_pkg_apply firewall "$rb_fo" "$rb_foh"
		rb_rc=$?
		if [ "$rb_rc" = 0 ]; then
			printf '{"error":"firewall reload failed; flow offload setting reverted"}'
		elif [ "$rb_rc" = 2 ]; then
			printf '{"error":"firewall reload failed; flow offload setting was modified concurrently and not reverted"}'
		else
			printf '{"error":"firewall reload failed and reverting the setting also failed"}'
		fi
		return
	fi
	printf '{"result":"ok","enabled":%s}' "$en"
}

set_flow_offload() {
	local en
	en=$(json_input "$1" enabled)
	case "$en" in 0|1) ;; *) printf '{"error":"enabled must be 0 or 1"}'; return ;; esac
	if [ -z "$R" ]; then
		set_flow_offload_rpcd "$en"
	else
		# The offline test root has no rpcd serving its UCI directory.
		set_flow_offload_cas "$en"
	fi
}

# Rewrite one module configuration file. Autoload entries must keep the
# module name even when wed_enable was their only argument. modules.conf gets
# the one canonical value; boot and normal autoload then inherit that value.
wed_rewrite() {
	awk -v mod="$1" -v val="$2" -v conf="$3" "$KARGS_AWK$WED_LINES_AWK"'
		# Put the setting before any kernel -- terminator without changing
		# which other arguments after that terminator are ignored.
		BEGIN { if (conf) print "options " mod " wed_enable=" val }
		{
			if (!wed_line($0, conf)) { print; next }
			n = kargs(WA_ARGS, t); rest = ""; hit = 0
			for (j = 1; j <= n; j++) {
				karg(t[j])
				if (KN == "wed_enable") hit = 1; else rest = rest " " t[j]
			}
			if (!hit) { print; next }
			# A shared conf/autoload line must keep an argument: the conf
			# loader cannot parse a bare module name safely.
			if (conf == 2 && !WA_CONF) rest = " wed_enable=" val rest
			if (!WA_CONF || rest != "") print WA_PREFIX rest (WA_SUFFIX != "" ? " " WA_SUFFIX : "")
			else if (WA_SUFFIX != "") print WA_SUFFIX
		}
		' "$4"
}

# Stage all affected files before replacing any. The temporary files are
# hidden in the destination directory: rename/rollback stay on one filesystem,
# and kmodloader never mistakes a leftover staging file for an autoload entry.
wed_stage() {
	local mod="$1" val="$2" f target conf tmp old step seen="$NL" i=0 shared=0 conf_target tag=${WED_TXN##*.}
	case "$tag" in ''|*[!A-Za-z0-9_]*) tag=$$ ;; esac
	conf_target=$(readlink -f "$MODCONF") || return 1
	for f in "$R"/etc/modules-boot.d/* "$R"/etc/modules.d/*; do
		[ -f "$f" ] || continue
		[ "$(readlink -f "$f")" != "$conf_target" ] || shared=1
	done
	set -- "$MODCONF" "$R"/etc/modules-boot.d/* "$R"/etc/modules.d/*
	for f in "$@"; do
		conf=0
		if [ "$f" = "$MODCONF" ]; then
			conf=$((1 + shared))
			[ ! -e "$f" ] || [ -f "$f" ] || return 1
		else
			[ -f "$f" ] || continue
		fi
		target=$(readlink -f "$f") || return 1
		case "$target" in ''|*"$NL"*) return 1 ;; esac
		case "$seen" in *"$NL$target$NL"*) continue ;; esac
		seen="$seen$target$NL"
		if [ -f "$target" ]; then
			# A quote spanning lines/files cannot be rewritten independently.
			# Reject it before installing any file; preserve unrelated entries.
			LC_ALL=C awk -v mod="$mod" -v conf="$conf" "$KARGS_AWK$WED_LINES_AWK"'
				# Rewriting a split loader record can change its quote state.
				conf && length($0) > 511 { toolong = 1; exit }
				wed_line($0, conf) {
					q = WA_ARGS
					if (gsub(/"/, "", q) % 2) { unclosed = 1; exit }
					n = kargs(WA_ARGS, t)
					for (j = 1; j <= n; j++) { karg(t[j]); if (KN == "wed_enable") hit = 1 }
				}
				END { if (toolong) exit 12; if (unclosed) exit 11; if (hit) exit 10 }
				' "$target" >/dev/null 2>&1
			case "$?" in
				0) [ "$conf" != 0 ] || continue ;;
				10) ;;
				12) WED_STAGE_ERROR='cannot safely save WED settings with oversized configuration lines'; return 1 ;;
				11) WED_STAGE_ERROR='cannot safely save WED settings with quotes spanning lines or files'; return 1 ;;
				*) return 1 ;;
			esac
		fi
		i=$((i + 1)); step="$WED_TXN/$i"
		mkdir "$step" || return 1
		printf '%s\n' "$target" > "$step/path" || return 1
		tmp=$(mktemp "${target%/*}/.mtkw-new.$tag.XXXXXX" 2>/dev/null) || return 1
		cleanup_add "$tmp"
		printf '%s\n' "$tmp" > "$step/new" && cleanup_del "$tmp" || { rm -f "$tmp"; cleanup_del "$tmp"; return 1; }
		if [ -f "$target" ]; then
			old=$(mktemp "${target%/*}/.mtkw-old.$tag.XXXXXX" 2>/dev/null) || return 1
			cleanup_add "$old"
			printf '%s\n' "$old" > "$step/old" && cleanup_del "$old" || { rm -f "$old"; cleanup_del "$old"; return 1; }
			cp -p "$target" "$old" && cp -p "$target" "$tmp" || return 1
			wed_rewrite "$mod" "$val" "$conf" "$target" > "$tmp" || return 1
		else
			chmod 0644 "$tmp" || return 1
			wed_rewrite "$mod" "$val" "$conf" /dev/null > "$tmp" || return 1
		fi
	done
}

wed_write_state() {
	local dir="$1" st="$2"
	printf '%s\n' "$st" > "$dir/.state.tmp" 2>/dev/null && mv -f "$dir/.state.tmp" "$dir/state" 2>/dev/null
}

# True when $1 contains no entries at all, or only a regular non-symlink
# .state.tmp file (e.g. SIGKILL right after mktemp -d or before mv .state.tmp state).
wed_dir_is_empty() {
	local d="$1" f
	for f in "$d"/* "$d"/.[!.]* "$d"/..?*; do
		[ -e "$f" ] || [ -L "$f" ] || continue
		if [ "$f" = "$d/.state.tmp" ] && [ -f "$f" ] && [ ! -L "$f" ]; then
			continue
		fi
		return 1
	done
	return 0
}

# Collect numeric step subdirs in $1 in true descending numeric order into $WED_REV.
# Sets WED_STEP_COUNT to the number of numeric step subdirs found.
wed_collect_rev_steps() {
	local d="$1" step idx
	WED_REV=
	WED_STEP_COUNT=0
	for step in "$d"/[0-9]*; do
		[ -d "$step" ] || continue
		idx=${step##*/}
		case "$idx" in ''|*[!0-9]*) continue ;; esac
		WED_STEP_COUNT=$((WED_STEP_COUNT + 1))
	done
	[ "$WED_STEP_COUNT" -gt 0 ] || return 0
	WED_REV=$(for step in "$d"/[0-9]*; do
		[ -d "$step" ] || continue
		idx=${step##*/}
		case "$idx" in ''|*[!0-9]*) continue ;; esac
		printf '%s\n' "$idx"
	done | sort -rn | tr '\n' ' ')
	WED_REV=${WED_REV% }
}

wed_restore() {
	local idx step target tmp old
	WED_RESTORE_FAILED=0
	for idx in $CLEANUP_WED_REV_STEPS; do
		step="$WED_TXN/$idx"
		if [ ! -d "$step" ]; then
			WED_RESTORE_FAILED=1
			continue
		fi
		[ ! -f "$step/restored" ] || continue
		rd "$step/path"; target=$RD
		rd "$step/new"; tmp=$RD
		if [ -z "$target" ] || [ -z "$tmp" ]; then
			WED_RESTORE_FAILED=1
			continue
		fi
		# When mv -f "$tmp" "$target" succeeded, the staged file $tmp is gone.
		[ ! -e "$tmp" ] || continue
		if [ -f "$step/old" ]; then
			rd "$step/old"; old=$RD
			if [ -n "$old" ] && [ -e "$old" ] && mv -f "$old" "$target" 2>/dev/null; then
				: > "$step/restored" 2>/dev/null
			else
				WED_RESTORE_FAILED=1
			fi
		else
			if rm -f "$target" 2>/dev/null; then
				: > "$step/restored" 2>/dev/null
			else
				WED_RESTORE_FAILED=1
			fi
		fi
	done
}

wed_cleanup() {
	local step file tag=${WED_TXN##*.} dir
	case "$tag" in ''|*[!A-Za-z0-9_]*) tag= ;; esac
	for step in "$WED_TXN"/[0-9]*; do
		[ -d "$step" ] || continue
		for file in new old; do rd "$step/$file"; [ -z "$RD" ] || rm -f "$RD"; done
		if [ -n "$tag" ]; then
			rd "$step/path"
			if [ -n "$RD" ]; then
				dir=${RD%/*}
				rm -f "$dir"/.mtkw-new."$tag".* "$dir"/.mtkw-old."$tag".* 2>/dev/null
			fi
		fi
		rm -rf "$step" 2>/dev/null
	done
	rm -f "$WED_TXN/steps" "$WED_TXN/rev_steps" "$WED_TXN/.state.tmp" 2>/dev/null
	rm -f "$WED_TXN/state" 2>/dev/null
	rm -rf "$WED_TXN"
	if [ "$CLEANUP_WED_TXN" = "$WED_TXN" ]; then
		CLEANUP_WED_TXN=
		CLEANUP_WED_COMMITTING=0
		CLEANUP_WED_REV_STEPS=
	fi
	return 0
}

# Recover interrupted $STATE/wed-save.* journals (e.g. SIGKILL from rpcd exec timeout
# or legacy 2.0.0-4 journals without a state file).
# Caller MUST already hold $STATE/settings.lock on FD 4.
# Sets WED_RECOVERY_PATH and returns 1 if any transaction cannot be safely restored.
wed_recover_pending() {
	local d st step idx target tmp old ok f
	local WED_TXN WED_RESTORE_FAILED=0 CLEANUP_WED_REV_STEPS= WED_REV= WED_STEP_COUNT=0 rc=0
	WED_RECOVERY_PATH=
	for d in "$STATE"/wed-save.*; do
		[ -d "$d" ] || continue
		WED_TXN=$d
		if [ -e "$d/state" ]; then
			rd "$d/state"; st=$RD
			case "$st" in
				staging|committed)
					wed_cleanup
					;;
				committing|restore_failed)
					rd "$d/rev_steps"; CLEANUP_WED_REV_STEPS=$RD
					if [ -z "$CLEANUP_WED_REV_STEPS" ]; then
						wed_collect_rev_steps "$d"
						CLEANUP_WED_REV_STEPS=$WED_REV
					fi
					if [ -z "$CLEANUP_WED_REV_STEPS" ]; then
						WED_RESTORE_FAILED=1
					else
						wed_restore
					fi
					if [ "$WED_RESTORE_FAILED" = 1 ]; then
						wed_write_state "$d" restore_failed
						[ -n "$WED_RECOVERY_PATH" ] || WED_RECOVERY_PATH=$d
						rc=1
					else
						wed_cleanup
					fi
					;;
				*)
					# Corrupt, empty, or unrecognized state: preserve untouched.
					[ -n "$WED_RECOVERY_PATH" ] || WED_RECOVERY_PATH=$d
					rc=1
					;;
			esac
		elif wed_dir_is_empty "$d"; then
			# Pre-stage dir (strictly empty or only regular .state.tmp before mv to state).
			wed_cleanup
		else
			# Non-empty dir without state (e.g. legacy 2.0.0-4 journal):
			# restore only when progress is unambiguously identifiable and restorable;
			# otherwise preserve $d and all backups untouched.
			wed_collect_rev_steps "$d"
			ok=1
			[ "$WED_STEP_COUNT" -gt 0 ] || ok=0
			if [ "$ok" = 1 ]; then
				for f in "$d"/* "$d"/.[!.]* "$d"/..?*; do
					[ -e "$f" ] || [ -L "$f" ] || continue
					idx=${f##*/}
					case "$idx" in ''|*[!0-9]*) ok=0; break ;; esac
					[ -d "$f" ] || { ok=0; break; }
				done
			fi
			if [ "$ok" = 1 ]; then
				for idx in $WED_REV; do
					step="$d/$idx"
					rd "$step/path"; target=$RD
					rd "$step/new"; tmp=$RD
					if [ -z "$target" ] || [ -z "$tmp" ]; then
						ok=0; break
					fi
					if [ ! -e "$tmp" ] && [ ! -f "$step/restored" ] && [ -f "$step/old" ]; then
						rd "$step/old"; old=$RD
						if [ -z "$old" ] || [ ! -e "$old" ]; then
							ok=0; break
						fi
					fi
				done
			fi
			if [ "$ok" = 1 ]; then
				CLEANUP_WED_REV_STEPS=$WED_REV
				wed_restore
				if [ "$WED_RESTORE_FAILED" = 1 ]; then
					wed_write_state "$d" restore_failed
					[ -n "$WED_RECOVERY_PATH" ] || WED_RECOVERY_PATH=$d
					rc=1
				else
					wed_cleanup
				fi
			else
				[ -n "$WED_RECOVERY_PATH" ] || WED_RECOVERY_PATH=$d
				rc=1
			fi
		fi
	done
	return "$rc"
}

# Zero-overhead recovery & busy probe for getStatus:
# - Called while holding shared FD 9 on $STATE/wed.lock when writable.
# - Sets WED_SAVE_BUSY=1 if a wed-save.* journal exists and settings.lock is
#   busy or $STATE is unwritable (never reporting an intermediate state).
# - Otherwise recovers any leftover $STATE/wed-save.* journals under settings.lock.
wed_recover_if_idle() {
	local d found=0
	WED_RECOVERY_PATH=
	WED_SAVE_BUSY=0
	for d in "$STATE"/wed-save.*; do
		[ -d "$d" ] && { found=1; break; }
	done
	[ "$found" = 1 ] || return 0
	if [ ! -d "$STATE" ] || [ ! -w "$STATE" ]; then
		WED_SAVE_BUSY=1
		return 0
	fi
	{
		if ! flock_wait x 4 0; then
			WED_SAVE_BUSY=1
			return 0
		fi
		wed_recover_pending || true
	} 4> "$STATE/settings.lock"
	return 0
}

set_wed_enable_body() {
	local en mod val=N step idx steps= rev_steps= target tmp failed=0 WED_RESTORE_FAILED=0 WED_RECOVERY_PATH= WED_REV= WED_STEP_COUNT=0 WED_TXN
	local WED_STAGE_ERROR='cannot prepare the WED settings'
	en=$(json_input "$1" enabled)
	case "$en" in 0|1) ;; *) printf '{"error":"enabled must be 0 or 1"}'; return ;; esac
	if ! wed_recover_pending; then
		js "$WED_RECOVERY_PATH"
		printf '{"error":"cannot save or restore the WED settings; recovery files: %s"}' "$JS"
		return
	fi
	[ "$en" = 1 ] && val=Y
	mod=$(wed_module)
	WED_TXN=$(mktemp -d "$STATE/wed-save.XXXXXX" 2>/dev/null) ||
		{ printf '{"error":"cannot prepare the WED settings"}'; return; }
	CLEANUP_WED_TXN=$WED_TXN
	CLEANUP_WED_COMMITTING=0
	CLEANUP_WED_REV_STEPS=
	wed_write_state "$WED_TXN" staging || { wed_cleanup; printf '{"error":"cannot prepare the WED settings"}'; return; }
	if ! wed_stage "$mod" "$val"; then
		wed_cleanup
		printf '{"error":"%s"}' "$WED_STAGE_ERROR"
		return
	fi
	wed_collect_rev_steps "$WED_TXN"
	rev_steps=$WED_REV
	for idx in $rev_steps; do
		steps="$idx${steps:+ $steps}"
	done
	if ! { printf '%s\n' "$steps" > "$WED_TXN/steps" &&
		printf '%s\n' "$rev_steps" > "$WED_TXN/rev_steps" &&
		wed_write_state "$WED_TXN" committing; } 2>/dev/null; then
		wed_cleanup
		printf '{"error":"cannot prepare the WED settings"}'
		return
	fi
	CLEANUP_WED_REV_STEPS=$rev_steps
	CLEANUP_WED_COMMITTING=1
	for idx in $steps; do
		step="$WED_TXN/$idx"
		rd "$step/path"; target=$RD
		rd "$step/new"; tmp=$RD
		if ! mv -f "$tmp" "$target" 2>/dev/null; then failed=1; break; fi
	done
	if [ "$failed" = 1 ]; then
		wed_restore
		if [ "$WED_RESTORE_FAILED" = 1 ]; then
			# Keep the originals and path mappings if a restore also failed.
			wed_write_state "$WED_TXN" restore_failed
			CLEANUP_WED_TXN=
			CLEANUP_WED_COMMITTING=0
			CLEANUP_WED_REV_STEPS=
			js "$WED_TXN"
			printf '{"error":"cannot save or restore the WED settings; recovery files: %s"}' "$JS"
		else
			CLEANUP_WED_COMMITTING=0
			wed_cleanup
			printf '{"error":"cannot save the WED settings; previous settings restored"}'
		fi
		return
	fi
	wed_write_state "$WED_TXN" committed
	CLEANUP_WED_COMMITTING=0
	wed_cleanup
	printf '{"result":"ok","enabled":%s,"module":"%s","reboot_required":true}' "$en" "$mod"
}

set_wed_enable() {
	local rc
	[ -d "$STATE" ] || mkdir -p -m 0700 "$STATE" 2>/dev/null
	{
		flock_wait x 9 "$SETTINGS_LOCK_WAIT"
		rc=$?
		if [ "$rc" = 1 ]; then
			printf '{"error":"another save is in progress"}'
			return 0
		elif [ "$rc" != 0 ]; then
			printf '{"error":"cannot lock the settings"}'
			return 0
		fi
		set_wed_enable_body "$1"
		return 0
	} 9> "$STATE/wed.lock" || printf '{"error":"cannot lock the settings"}'
}

cpu_restore() {
	local txn="$1" applied="$2" idx step p og of
	CPU_RESTORE_FAILED=0
	for idx in $applied; do
		step="$txn/$idx"
		rd "$step/path"; p=$RD
		rd "$step/gov"; og=$RD
		rd "$step/freq"; of=$RD
		if [ -n "$og" ]; then
			rd "$p/scaling_governor"
			[ "$RD" = "$og" ] || printf '%s\n' "$og" 2>/dev/null > "$p/scaling_governor" || CPU_RESTORE_FAILED=1
		fi
		if [ -n "$of" ]; then
			rd "$p/scaling_max_freq"
			[ "$RD" = "$of" ] || printf '%s\n' "$of" 2>/dev/null > "$p/scaling_max_freq" || CPU_RESTORE_FAILED=1
		fi
	done
}

set_cpu_settings() {
	local gov freq p ok_gov=0 ok_freq=0 p_gov p_freq f failed=0 txn i=0 step applied= CPU_RESTORE_FAILED=0
	gov=$(json_input "$1" governor)
	freq=$(json_input "$1" freq)
	p=$(cpu_policy)
	[ -n "$p" ] || { printf '{"error":"cpufreq unavailable"}'; return; }
	for p in "$R"/sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$p" ] || continue
		for f in $(read_first "$p/scaling_available_governors"); do [ "$f" = "$gov" ] && { ok_gov=1; break; }; done
		for f in $(read_first "$p/scaling_available_frequencies"); do [ "$f" = "$freq" ] && { ok_freq=1; break; }; done
	done
	[ "$ok_gov" = 1 ] || { printf '{"error":"unsupported governor"}'; return; }
	[ "$ok_freq" = 1 ] || { printf '{"error":"unsupported frequency"}'; return; }
	[ -d "$STATE" ] || mkdir -p -m 0700 "$STATE" 2>/dev/null
	txn=$(mktemp -d "$STATE/cpu-save.XXXXXX" 2>/dev/null) ||
		{ printf '{"error":"cannot apply the CPU settings"}'; return; }
	cleanup_add "$txn"
	# Validate per policy (matching init.d/mtk-wed) and snapshot every touched
	# policy before mutating sysfs so partial failures roll back atomically.
	for p in "$R"/sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$p" ] || continue
		p_gov=0; p_freq=0
		for f in $(read_first "$p/scaling_available_governors"); do [ "$f" = "$gov" ] && { p_gov=1; break; }; done
		for f in $(read_first "$p/scaling_available_frequencies"); do [ "$f" = "$freq" ] && { p_freq=1; break; }; done
		[ "$p_gov" = 1 ] || [ "$p_freq" = 1 ] || continue
		i=$((i + 1)); step="$txn/$i"
		mkdir "$step" && printf '%s\n' "$p" > "$step/path" &&
			printf '%s\n' "$p_gov" > "$step/do_gov" &&
			printf '%s\n' "$p_freq" > "$step/do_freq" ||
			{ rm -rf "$txn"; cleanup_del "$txn"; printf '{"error":"cannot apply the CPU settings"}'; return; }
		if [ "$p_gov" = 1 ]; then
			rd "$p/scaling_governor"; printf '%s\n' "$RD" > "$step/gov" || { rm -rf "$txn"; cleanup_del "$txn"; printf '{"error":"cannot apply the CPU settings"}'; return; }
		fi
		if [ "$p_freq" = 1 ]; then
			rd "$p/scaling_max_freq"; printf '%s\n' "$RD" > "$step/freq" || { rm -rf "$txn"; cleanup_del "$txn"; printf '{"error":"cannot apply the CPU settings"}'; return; }
		fi
	done
	[ "$i" -gt 0 ] || { rm -rf "$txn"; cleanup_del "$txn"; printf '{"error":"cannot apply the CPU settings"}'; return; }
	CLEANUP_CPU_TXN=$txn
	CLEANUP_CPU_APPLIED=
	CLEANUP_CPU_GOV=$gov
	CLEANUP_CPU_FREQ=$freq
	CLEANUP_CPU_COMMITTING=1
	for step in "$txn"/[0-9]*; do
		[ -d "$step" ] || continue
		rd "$step/path"; p=$RD
		rd "$step/do_gov"; p_gov=$RD
		rd "$step/do_freq"; p_freq=$RD
		applied="${step##*/} $applied"
		CLEANUP_CPU_APPLIED=$applied
		if [ "$p_gov" = 1 ]; then
			if ! printf '%s\n' "$gov" 2>/dev/null > "$p/scaling_governor"; then failed=1; break; fi
		fi
		if [ "$p_freq" = 1 ]; then
			if ! printf '%s\n' "$freq" 2>/dev/null > "$p/scaling_max_freq"; then failed=1; break; fi
		fi
	done
	if [ "$failed" = 1 ]; then
		cpu_restore "$txn" "$applied"
		CLEANUP_CPU_COMMITTING=0
		CLEANUP_CPU_TXN=
		CLEANUP_CPU_APPLIED=
		CLEANUP_CPU_GOV=
		CLEANUP_CPU_FREQ=
		rm -rf "$txn"; cleanup_del "$txn"
		if [ "$CPU_RESTORE_FAILED" = 1 ]; then
			printf '{"error":"saving the CPU settings failed and restoring previous settings also failed"}'
		else
			printf '{"error":"cannot apply the CPU settings"}'
		fi
		return
	fi
	CLEANUP_CPU_COMMITTING=2
	if ! uci_pkg_apply mtk_wed 'set:cpu=cpu' "set:cpu.governor=$gov" "set:cpu.max_freq=$freq"; then
		CLEANUP_CPU_COMMITTING=1
		cpu_restore "$txn" "$applied"
		CLEANUP_CPU_COMMITTING=0
		CLEANUP_CPU_TXN=
		CLEANUP_CPU_APPLIED=
		CLEANUP_CPU_GOV=
		CLEANUP_CPU_FREQ=
		rm -rf "$txn"; cleanup_del "$txn"
		if [ "$CPU_RESTORE_FAILED" = 1 ]; then
			printf '{"error":"saving the CPU settings failed and restoring previous settings also failed"}'
		else
			printf '{"error":"cannot save the CPU settings; previous settings restored"}'
		fi
		return
	fi
	CLEANUP_CPU_COMMITTING=0
	CLEANUP_CPU_TXN=
	CLEANUP_CPU_APPLIED=
	CLEANUP_CPU_GOV=
	CLEANUP_CPU_FREQ=
	rm -rf "$txn"; cleanup_del "$txn"
	printf '{"result":"ok","governor":"%s","freq":%s}' "$gov" "$freq"
}

case "$1" in
	list)
		printf '{"getStatus":{"skip_ppe":true},"getPorts":{},"getPpeEntries":{"page":0,"state":"","type":"","ppe":"","refresh":true,"interval":0},"getMacStats":{},"getWifiStats":{},"setFlowOffload":{"enabled":0},"setWedEnable":{"enabled":0},"setCpuSettings":{"governor":"","freq":0}}'
		;;
	call)
		[ -d "$STATE" ] || mkdir -p -m 0700 "$STATE" 2>/dev/null
		case "$2" in
			getStatus) read -r input; get_status "$input" ;;
			getPorts) get_ports ;;
			getPpeEntries) read -r input; get_ppe_entries "$input" ;;
			getMacStats) get_mac_stats ;;
			getWifiStats) get_wifi_stats ;;
			setFlowOffload) read -r input; locked set_flow_offload "$input" ;;
			setWedEnable) read -r input; locked set_wed_enable "$input" ;;
			setCpuSettings) read -r input; locked set_cpu_settings "$input" ;;
			*) printf '{"error":"unknown method"}' ;;
		esac
		;;
esac
