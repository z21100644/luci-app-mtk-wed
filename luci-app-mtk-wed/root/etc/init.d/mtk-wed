#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# Re-apply the CPU governor / max frequency saved from the LuCI page.

START=99

apply_cpu() {
	local gov freq p f ok
	config_get gov cpu governor
	config_get freq cpu max_freq
	for p in /sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$p" ] || continue
		if [ -n "$gov" ]; then
			ok=0
			for f in $(cat "$p/scaling_available_governors" 2>/dev/null); do [ "$f" = "$gov" ] && ok=1; done
			if [ "$ok" = 1 ]; then echo "$gov" 2>/dev/null > "$p/scaling_governor" || :; fi
		fi
		if [ -n "$freq" ]; then
			ok=0
			for f in $(cat "$p/scaling_available_frequencies" 2>/dev/null); do [ "$f" = "$freq" ] && ok=1; done
			if [ "$ok" = 1 ]; then echo "$freq" 2>/dev/null > "$p/scaling_max_freq" || :; fi
		fi
	done
	return 0
}

start() {
	config_load mtk_wed
	apply_cpu
}
